const express = require("express");

const router = express.Router();

const whatsapp = require("../services/whatsappService");

const {
  getShopByWhatsAppPhoneNumberId
} = require("../services/shopService");

const kendra = require("../services/kendraService");


/*
|--------------------------------------------------------------------------
| CONNEXION WHATSAPP — META EMBEDDED SIGNUP
|--------------------------------------------------------------------------
|
| Le frontend transmet :
|
| {
|   shopId,
|   code,
|   wabaId,
|   phoneNumberId,
|   phoneNumber
| }
|
| Le code est échangé côté serveur contre le token
| WhatsApp de la boutique.
|
| Le WABA et le Phone Number ID ne sont pas obligatoires
| ici : le service WhatsApp peut les récupérer si nécessaire.
|
|--------------------------------------------------------------------------
*/

router.post("/connect", async (req, res) => {

  try {

    const {
      shopId,
      code,
      wabaId,
      phoneNumberId,
      phoneNumber
    } = req.body || {};


    /*
    |--------------------------------------------------------------------------
    | VÉRIFICATION SHOP
    |--------------------------------------------------------------------------
    */

    const cleanShopId =
      String(shopId || "").trim();

    if (!cleanShopId) {

      return res.status(400).json({
        success: false,
        error: "shopId est obligatoire"
      });

    }


    /*
    |--------------------------------------------------------------------------
    | CODE META
    |--------------------------------------------------------------------------
    */

    const cleanCode =
      String(code || "").trim();

    if (!cleanCode) {

      return res.status(400).json({
        success: false,
        error:
          "Code Meta Embedded Signup manquant"
      });

    }


    /*
    |--------------------------------------------------------------------------
    | DONNÉES META
    |--------------------------------------------------------------------------
    */

    const cleanWabaId =
      String(wabaId || "").trim();

    const cleanPhoneNumberId =
      String(phoneNumberId || "").trim();

    const cleanPhoneNumber =
      String(phoneNumber || "").trim();


    console.log(
      "META EMBEDDED SIGNUP CONNECT:",
      {
        shopId:
          cleanShopId,

        wabaId:
          cleanWabaId || "(non fourni)",

        phoneNumberId:
          cleanPhoneNumberId || "(non fourni)",

        phoneNumber:
          cleanPhoneNumber || "(non fourni)",

        hasCode:
          Boolean(cleanCode)
      }
    );


    /*
    |--------------------------------------------------------------------------
    | CONNEXION WHATSAPP
    |--------------------------------------------------------------------------
    */

    const result =
      await whatsapp.connectWhatsApp(
        cleanShopId,
        {
          code:
            cleanCode,

          wabaId:
            cleanWabaId,

          phoneNumberId:
            cleanPhoneNumberId,

          phoneNumber:
            cleanPhoneNumber
        }
      );


    return res.json(result);

  } catch (error) {

    console.error(
      "WHATSAPP CONNECT ERROR:",
      error
    );

    return res.status(400).json({
      success: false,
      error:
        error.message
    });

  }

});


