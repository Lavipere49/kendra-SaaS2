| QR CODE
|--------------------------------------------------------------------------
*/
router.get("/qr", async (req, res) => {
  try {
    const shopId = await getAuthenticatedShopId(req);
    const shop = await require("../services/shopService").getShop(shopId);
    const whatsappConfig = shop?.whatsapp || {};
    const instanceName = String(whatsappConfig.evolutionInstanceName || "").trim();
    const instanceToken = String(whatsappConfig.evolutionInstanceToken || "").trim();
