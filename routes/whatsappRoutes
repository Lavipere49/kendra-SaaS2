/*
|--------------------------------------------------------------------------
| META WEBHOOK — VÉRIFICATION
|--------------------------------------------------------------------------
*/

router.get(
  "/webhook",
  (req, res) => {

    const mode =
      req.query["hub.mode"];

    const token =
      req.query["hub.verify_token"];

    const challenge =
      req.query["hub.challenge"];

    const verifyToken =
      String(
        process.env.WHATSAPP_VERIFY_TOKEN ||
        ""
      ).trim();


    if (
      mode === "subscribe" &&
      token &&
      verifyToken &&
      token === verifyToken
    ) {

      console.log(
        "META WEBHOOK VERIFIED"
      );

      return res
        .status(200)
        .send(challenge);

    }


    console.warn(
      "META WEBHOOK VERIFICATION FAILED"
    );

    return res.sendStatus(403);

  }
);


/*
|--------------------------------------------------------------------------
| META WEBHOOK — MESSAGES
|--------------------------------------------------------------------------
*/

router.post(
  "/webhook",
  async (req, res) => {

    try {

      const body =
        req.body;


      /*
      |--------------------------------------------------------------------------
      | VÉRIFICATION ÉVÉNEMENT WHATSAPP
      |--------------------------------------------------------------------------
      */

      if (
        !body ||
        body.object !==
          "whatsapp_business_account"
      ) {

        return res.sendStatus(404);

      }


      /*
      |--------------------------------------------------------------------------
      | ENTRÉES META
      |--------------------------------------------------------------------------
      */

      for (
        const entry of
        body.entry || []
      ) {

        for (
          const change of
          entry.changes || []
        ) {

          if (
            change.field !==
            "messages"
          ) {
            continue;
          }


          const value =
            change.value || {};


          /*
          |--------------------------------------------------------------------------
          | PHONE NUMBER ID
          |--------------------------------------------------------------------------
          */

          const phoneNumberId =
            String(
              value.metadata?.phone_number_id ||
              ""
            ).trim();


          if (!phoneNumberId) {

            console.warn(
              "META WEBHOOK: phone_number_id missing"
            );

            continue;

          }


          /*
          |--------------------------------------------------------------------------
          | RECHERCHE DE LA BOUTIQUE
          |--------------------------------------------------------------------------
          */

          const shop =
            await getShopByWhatsAppPhoneNumberId(
              phoneNumberId
            );


          if (!shop) {

            console.warn(
              "META WEBHOOK: SHOP NOT FOUND FOR PHONE NUMBER:",
              phoneNumberId
            );

            continue;

          }


          /*
          |--------------------------------------------------------------------------
          | MESSAGES
          |--------------------------------------------------------------------------
          */

          for (
            const message of
            value.messages || []
          ) {

            /*
            |--------------------------------------------------------------------------
            | MESSAGE TEXTE
            |--------------------------------------------------------------------------
            */

            if (
              message.type !==
              "text"
            ) {

              console.log(
                "META MESSAGE TYPE NOT SUPPORTED:",
                message.type
              );

              continue;

            }


            const from =
              String(
                message.from || ""
              ).trim();


            const text =
              String(
                message.text?.body || ""
              ).trim();


            if (
              !from ||
              !text
            ) {
              continue;
            }


            console.log(
              `MESSAGE FROM ${from} -> SHOP ${shop.id}:`,
              text
            );


            /*
            |--------------------------------------------------------------------------
            | CLIENT
            |--------------------------------------------------------------------------
            */

            const customerId =
              from;


            /*
            |--------------------------------------------------------------------------
            | KENDRA
            |--------------------------------------------------------------------------
            */

            const result =
              await kendra.handleMessage({

                shopId:
                  shop.id,

                customerId,

                text,

                channel:
                  "whatsapp"

              });


            /*
            |--------------------------------------------------------------------------
            | RÉPONSE KENDRA
            |--------------------------------------------------------------------------
            */

            if (
              result?.reply
            ) {

              await whatsapp.sendMessage({

                shopId:
                  shop.id,

                to:
                  from,

                text:
                  result.reply

              });

            }

          }

        }

      }


      /*
      |--------------------------------------------------------------------------
      | META ATTEND HTTP 200
      |--------------------------------------------------------------------------
      */

      return res.sendStatus(200);

    } catch (error) {

      console.error(
        "META WHATSAPP WEBHOOK ERROR:",
        error
      );


      /*
      * On répond quand même 200 à Meta pour éviter
      * des répétitions inutiles du même événement.
      */

      return res.sendStatus(200);

    }

  }
);


/*
|--------------------------------------------------------------------------
| ROUTE INTERNE — MESSAGE ENTRANT
|--------------------------------------------------------------------------
*/

router.post(
  "/:shopId/incoming",
  async (req, res) => {

    try {

      const shopId =
        String(
          req.params.shopId || ""
        ).trim();

      const {
        customerId,
        text
      } = req.body || {};


      if (
        !shopId ||
        !customerId ||
        !text
      ) {

        return res.status(400).json({
          success: false,
          error:
            "shopId, customerId et text sont obligatoires"
        });

      }


      const result =
        await kendra.handleMessage({

          shopId,

          customerId:
            String(customerId),

          text:
            String(text),

          channel:
            "whatsapp"

        });


      return res.json({
        success: true,
        ...result
      });

    } catch (error) {

      console.error(
        "WHATSAPP INCOMING ERROR:",
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error.message
      });

    }

  }
);


/*
|--------------------------------------------------------------------------
| ROUTE INTERNE — ENVOYER UN MESSAGE
|--------------------------------------------------------------------------
*/

router.post(
  "/:shopId/send",
  async (req, res) => {

    try {

      const shopId =
        String(
          req.params.shopId || ""
        ).trim();

      const {
        to,
        text
      } = req.body || {};


      const cleanTo =
        String(
          to || ""
        ).trim();

      const cleanText =
        String(
          text || ""
        ).trim();


      if (
        !shopId ||
        !cleanTo ||
        !cleanText
      ) {

        return res.status(400).json({
          success: false,
          error:
            "shopId, to et text sont obligatoires"
        });

      }


      const result =
        await whatsapp.sendMessage({

          shopId,

          to:
            cleanTo,

          text:
            cleanText

        });


      return res.json({

        success:
          true,

        result

      });

    } catch (error) {

      console.error(
        "WHATSAPP SEND ERROR:",
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error.message
      });

    }

  }
);


module.exports = router;
