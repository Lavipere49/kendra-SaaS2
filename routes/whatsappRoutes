const express = require("express");
const router = express.Router();

const whatsapp = require("../services/whatsappService");
const {
  getShopByEvolutionInstanceName
} = require("../services/shopService");
const kendra = require("../services/kendraService");
const { admin, getDb } = require("../config/firebase");

async function getAuthenticatedShopId(req) {
  const authorization = String(req.headers.authorization || "");
  if (!authorization.startsWith("Bearer ")) {
    const error = new Error("AUTHENTICATION_REQUIRED");
    error.status = 401;
    throw error;
  }

  const idToken = authorization.slice(7).trim();
  const decoded = await admin.auth().verifyIdToken(idToken);
  const uid = String(decoded.uid || "").trim();
  if (!uid) throw Object.assign(new Error("FIREBASE_UID_MANQUANT"), { status: 401 });

  const snap = await getDb().collection("users").doc(uid).get();
  if (!snap.exists) throw Object.assign(new Error("MERCHANT_PROFILE_NOT_FOUND"), { status: 403 });

  const shopId = String(snap.data()?.shopId || "").trim();
  if (!shopId) throw Object.assign(new Error("SHOP_ID_NOT_LINKED_TO_MERCHANT"), { status: 403 });
  return shopId;
}

/*
|--------------------------------------------------------------------------
| CRÉER/OUVRIR UNE CONNEXION EVOLUTION
|--------------------------------------------------------------------------
*/
router.post("/connect", async (req, res) => {
  try {
    const shopId = await getAuthenticatedShopId(req);
    const phoneNumber = String(req.body?.phoneNumber || "").trim();
    const result = await whatsapp.connectWhatsApp(shopId, { phoneNumber });
    return res.json(result);
  } catch (error) {
    console.error("EVOLUTION CONNECT ERROR:", error);
    return res.status(error.status || 400).json({ success: false, error: error.message });
  }
});

/*
