      return res.status(400).json({ success: false, error: "INSTANCE_EVOLUTION_MANQUANTE" });
    }

    // Reuse the same connection bootstrap; Evolution can return a fresh QR.
    const result = await whatsapp.connectWhatsApp(shopId, {});
    return res.json(result);
  } catch (error) {
    console.error("EVOLUTION QR ERROR:", error);
    return res.status(error.status || 400).json({ success: false, error: error.message });
  }
});

