/*
|--------------------------------------------------------------------------
| WEBHOOK EVOLUTION API
|--------------------------------------------------------------------------
*/
router.post("/evolution/webhook", async (req, res) => {
  try {
    const expectedSecret = String(process.env.EVOLUTION_WEBHOOK_SECRET || "").trim();
    if (expectedSecret) {
      const received = String(req.query.secret || req.headers["x-evolution-secret"] || "").trim();
      if (received !== expectedSecret) return res.sendStatus(401);
    }

    const normalized = whatsapp.normalizeEvolutionWebhook(req.body || {});
    if (!normalized.instance) return res.sendStatus(200);

    const shop = await getShopByEvolutionInstanceName(normalized.instance);
    if (!shop) {
      console.warn("EVOLUTION WEBHOOK: SHOP NOT FOUND:", normalized.instance);
      return res.sendStatus(200);
    }

    const event = normalized.event;

    if (event.includes("CONNECTION_UPDATE") || event.includes("CONNECTION")) {
      const state = String(
        req.body?.data?.state ||
        req.body?.data?.status ||
        req.body?.data?.connection ||
        ""
      ).toLowerCase();
      const connected = ["open", "connected", "online"].includes(state);
      await require("../services/shopService").updateShop(shop.id, {
        whatsapp: {
          ...(shop.whatsapp || {}),
          provider: "evolution",
          connected,
          updatedAt: new Date().toISOString()
        }
      });
    }

    if (
      (event.includes("MESSAGES_UPSERT") || event === "MESSAGE" || event.includes("MESSAGE_UPSERT")) &&
      normalized.remoteJid &&
      !normalized.fromMe &&
      normalized.text
    ) {
      const customerId = normalized.remoteJid.split("@")[0];
      const result = await kendra.handleMessage({
        shopId: shop.id,
        customerId,
        text: normalized.text,
        channel: "whatsapp"
      });

      if (result?.reply) {
        await whatsapp.sendMessage({
          shopId: shop.id,
          to: customerId,
          text: result.reply
        });
      }
    }

    return res.sendStatus(200);
  } catch (error) {
    console.error("EVOLUTION WEBHOOK ERROR:", error);
    return res.sendStatus(200);
  }
});

/*
|--------------------------------------------------------------------------
| ENVOYER UN MESSAGE MANUELLEMENT
|--------------------------------------------------------------------------
*/
router.post("/:shopId/send", async (req, res) => {
  try {
    const shopId = await getAuthenticatedShopId(req);
    if (String(req.params.shopId) !== shopId) {
      return res.status(403).json({ success: false, error: "SHOP_ACCESS_DENIED" });
    }

    const to = String(req.body?.to || "").trim();
    const text = String(req.body?.text || "").trim();
    if (!to || !text) {
      return res.status(400).json({ success: false, error: "shopId, to et text sont obligatoires" });
    }

    return res.json({ success: true, result: await whatsapp.sendMessage({ shopId, to, text }) });
  } catch (error) {
    console.error("EVOLUTION SEND ERROR:", error);
    return res.status(error.status || 500).json({ success: false, error: error.message });
  }
});

module.exports = router;
