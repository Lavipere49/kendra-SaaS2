router.get("/shops", async (req, res) => {
  try {
    const db = getDb();
    const [shops, products] = await Promise.all([
      db.collection("shops").get(),
      db.collection("products").get()
    ]);

    const counts = {};
    products.docs.forEach(doc => {
      const shopId = String(doc.data().shopId || "");
      counts[shopId] = (counts[shopId] || 0) + 1;
    });

    const result = shops.docs.map(doc => {
      const shop = doc.data();

      return normalize({
        id: doc.id,
        ...shop,
        ownerName: shop.ownerName || "",
        email: shop.email || shop.ownerEmail || "",
        phone: shop.phone || shop.ownerPhone || "",
        productsCount: counts[doc.id] || 0
      });
    });

    res.json({ success: true, shops: result });
  } catch (e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

router.patch("/shops/:shopId/status", async (req, res) => {
  try {
    const status =
      req.body.status ||
      (req.body.active === true ? "active" : "suspended");

    const active =
      req.body.active !== undefined
        ? Boolean(req.body.active)
        : status === "active";

    await getDb().collection("shops")
      .doc(String(req.params.shopId))
      .set({
        status,
        active,
        updatedAt: timestamp()
      }, { merge: true });

    res.json({
      success: true,
      result: {
        shopId: String(req.params.shopId),
        status,
        active
      }
    });
  } catch (e) {
    res.status(400).json({ success: false, error: e.message });
  }
});

