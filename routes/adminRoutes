const router = require("express").Router();
const { getDb, timestamp } = require("../config/firebase");
const { PLANS } = require("../config/plans");

function normalize(value) {
  if (value && typeof value.toDate === "function") {
    return value.toDate().toISOString();
  }

  if (Array.isArray(value)) {
    return value.map(normalize);
  }

  if (value && typeof value === "object") {
    const out = {};
    for (const [key, val] of Object.entries(value)) {
      out[key] = normalize(val);
    }
    return out;
  }

  return value;
}

async function getAll(collection) {
  const snap = await getDb().collection(collection).get();
  return snap.docs.map(doc => normalize({ id: doc.id, ...doc.data() }));
}

async function getSettings() {
  const db = getDb();
  const [adminSnap, kendraSnap, mfSnap] = await Promise.all([
    db.collection("settings").doc("admin").get(),
    db.collection("settings").doc("kendra").get(),
    db.collection("settings").doc("moneyfusion").get()
  ]);

  return {
    ...(adminSnap.exists ? adminSnap.data() : {}),
    ...(kendraSnap.exists ? kendraSnap.data() : {}),
    moneyfusionConfigured:
      Boolean(process.env.MONEYFUSION_API_URL) &&
      Boolean(process.env.MONEYFUSION_PRIVATE_KEY),
    version: "4.0.0"
  };
}

/*
 * Le frontend Admin existant n'envoyait pas x-admin-key.
 * On garde donc le branchement fonctionnel sans inventer un nouveau
 * système de connexion ou modifier le frontend.
 *
 * Si ADMIN_API_KEY est défini, les requêtes Admin doivent fournir
 * x-admin-key. Cela permet de sécuriser le backend en production.
 */
function requireAdmin(req, res, next) {
  const configuredKey = process.env.ADMIN_API_KEY;

  if (!configuredKey) {
    return next();
  }

  if (req.headers["x-admin-key"] !== configuredKey) {
    return res.status(401).json({
      success: false,
      error: "ADMIN_NON_AUTORISE"
    });
  }

  next();
}

router.use(requireAdmin);

