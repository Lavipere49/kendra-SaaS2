========================= */

router.get("/vendors", async (req, res) => {
  try {
    const shops = await getAll("shops");

    const grouped = new Map();

    for (const shop of shops) {
      const id = String(shop.ownerId || shop.id);

      if (!grouped.has(id)) {
        grouped.set(id, {
          id,
          name: shop.ownerName || shop.ownerEmail || "Vendeur",
          email: shop.ownerEmail || shop.email || "",
          phone: shop.ownerPhone || shop.phone || "",
          shopName: shop.name || "",
          status: shop.status || (shop.active === false ? "suspended" : "active"),
          createdAt: shop.createdAt || null,
          shopsCount: 0
        });
      }

      grouped.get(id).shopsCount++;
    }

    res.json({
      success: true,
      vendors: [...grouped.values()]
    });
  } catch (e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

router.patch("/vendors/:vendorId/status", async (req, res) => {
  try {
    const status = String(req.body.status || "").trim();

    if (!["active", "pending", "suspended"].includes(status)) {
      return res.status(400).json({
        success: false,
        error: "STATUT_VENDEUR_INVALIDE"
      });
    }

    const db = getDb();
    const snap = await db.collection("shops")
      .where("ownerId", "==", String(req.params.vendorId))
      .get();

    const batch = db.batch();

    snap.docs.forEach(doc => {
      batch.set(doc.ref, {
        status,
        active: status === "active",
        updatedAt: timestamp()
      }, { merge: true });
    });

    await batch.commit();

    res.json({
      success: true,
      vendorId: String(req.params.vendorId),
      status,
      updated: snap.size
    });
  } catch (e) {
    res.status(400).json({ success: false, error: e.message });
  }
});

