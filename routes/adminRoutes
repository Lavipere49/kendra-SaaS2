router.put("/plans/:id", async (req, res) => {
  try {
    const stored = await getDb()
      .collection("settings")
      .doc("plans")
      .get();

    const plans = stored.exists
      ? (stored.data().plans || [])
      : Object.values(PLANS);

    const id = String(req.params.id).toUpperCase();
    const index = plans.findIndex(
      plan => String(plan.name).toUpperCase() === id
    );

    const plan = {
      ...(index >= 0 ? plans[index] : {}),
      ...req.body,
      name: req.body.name || (index >= 0 ? plans[index].name : id),
      price: Number(req.body.price ?? 0)
    };

    if (index >= 0) {
      plans[index] = plan;
    } else {
      plans.push(plan);
    }

    await getDb()
      .collection("settings")
      .doc("plans")
      .set({
        plans,
        updatedAt: timestamp()
      }, { merge: true });

    res.json({ success: true, plan });
  } catch (e) {
    res.status(400).json({ success: false, error: e.message });
  }
});

router.delete("/plans/:id", async (req, res) => {
  try {
    const stored = await getDb()
      .collection("settings")
      .doc("plans")
      .get();

    const plans = stored.exists
      ? (stored.data().plans || [])
      : Object.values(PLANS);

    const filtered = plans.filter(
      plan =>
        String(plan.name).toUpperCase() !==
        String(req.params.id).toUpperCase()
    );

    await getDb()
      .collection("settings")
      .doc("plans")
      .set({
        plans: filtered,
        updatedAt: timestamp()
      }, { merge: true });

    res.json({ success: true });
  } catch (e) {
    res.status(400).json({ success: false, error: e.message });
  }
});

