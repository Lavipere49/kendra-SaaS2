      vendors,
      shops: shops.size,
      products: products.size,
      orders: orders.size
    });
  } catch (e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

router.get("/subscriptions/summary", async (req, res) => {
  try {
    const subscriptions = await getAll("subscriptions");
    const now = Date.now();

    let active = 0;
    let pending = 0;
    let expired = 0;

    for (const subscription of subscriptions) {
      if (subscription.status === "pending") {
        pending++;
        continue;
      }

      const expires = subscription.expiresAt
        ? new Date(subscription.expiresAt).getTime()
        : null;

      if (subscription.status === "active" && (!expires || expires > now)) {
        active++;
      } else {
        expired++;
      }
    }

    res.json({ success: true, active, pending, expired });
  } catch (e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

