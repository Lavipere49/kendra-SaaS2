/*
|--------------------------------------------------------------------------
| CRÉER UN PAIEMENT D'ABONNEMENT
|--------------------------------------------------------------------------
*/

router.post("/:shopId/payment", async (req, res) => {
  try {

    const shopId = String(req.params.shopId);

    const planName = String(
      req.body.plan || ""
    ).toUpperCase();


    /*
    |--------------------------------------------------------------------------
    | Vérification du forfait
    |--------------------------------------------------------------------------
    */

    const plan = getPlan(planName);


    /*
    |--------------------------------------------------------------------------
    | Récupération de la boutique
    |--------------------------------------------------------------------------
    */

    const shop = await shopService.getShop(shopId);

    if (!shop) {
      return res.status(404).json({
        success: false,
        error: "Boutique introuvable"
      });
    }


    /*
    |--------------------------------------------------------------------------
    | FREE ne nécessite pas de paiement
    |--------------------------------------------------------------------------
    */

    if (plan.name === "FREE") {
      return res.status(400).json({
        success: false,
        error: "La formule FREE ne nécessite pas de paiement."
      });
    }


    /*
    |--------------------------------------------------------------------------
    | Informations client
    |--------------------------------------------------------------------------
    */

    const phone = String(
      req.body.phone ||
      shop.phone ||
      ""
    ).trim();


    const customerName = String(
      req.body.customerName ||
      shop.ownerName ||
      shop.name ||
      "Kendra"
    ).trim();


    if (!phone) {
      return res.status(400).json({
        success: false,
        error:
          "Le numéro de téléphone est obligatoire pour lancer le paiement."
      });
    }


    /*
    |--------------------------------------------------------------------------
    | Référence interne
    |--------------------------------------------------------------------------
    */

    const paymentRef =
      `KENDRA-${shopId}-${Date.now()}`;


    /*
    |--------------------------------------------------------------------------
    | URLs MoneyFusion
    |--------------------------------------------------------------------------
    */

    const webhookUrl =
      process.env.MONEYFUSION_WEBHOOK_URL || "";


    const returnUrl =
      process.env.MONEYFUSION_RETURN_URL || "";


    /*
    |--------------------------------------------------------------------------
    | Création du paiement MoneyFusion
    |--------------------------------------------------------------------------
    */

    const payment =
      await moneyFusion.requestPayment({

        totalPrice: plan.price,

        article: [
          {
            name: `Abonnement KENDRA ${plan.name}`,
            price: plan.price,
            quantity: 1
          }
        ],

        numeroSend: phone,

        nomclient: customerName,

        userId:
          shop.ownerId ||
          shopId,

        orderId: paymentRef,

        returnUrl,

        webhookUrl
      });


    /*
    |--------------------------------------------------------------------------
    | Enregistrement du paiement
    |--------------------------------------------------------------------------
    */

    await getDb()
      .collection("payments")
      .doc(String(payment.token))
      .set({

        tokenPay: String(payment.token),

        shopId,

        ownerId:
          String(shop.ownerId || ""),

        plan: plan.name,

        amount: Number(plan.price),

        type: "subscription",

        status: "pending",

        phone,

        customerName,

        reference: paymentRef,

        createdAt: timestamp(),

        updatedAt: timestamp()

      });


    /*
    |--------------------------------------------------------------------------
    | Réponse frontend
    |--------------------------------------------------------------------------
    */

    return res.json({

      success: true,

      plan: plan.name,

      amount: plan.price,

      token: payment.token,

      paymentUrl: payment.url,

      message:
        payment.message ||
        "Paiement en cours"

    });


  } catch (e) {

    console.error(
      "MoneyFusion payment error:",
      e
    );

    return res.status(400).json({

      success: false,

      error: e.message

    });
  }
});


