/*
|--------------------------------------------------------------------------
| WEBHOOK MONEYFUSION
|--------------------------------------------------------------------------
*/

router.post(
  "/moneyfusion/webhook",
  async (req, res) => {

    try {

      const body = req.body || {};


      /*
      |--------------------------------------------------------------------------
      | Récupération du token
      |--------------------------------------------------------------------------
      */

      const token =
        String(
          body.tokenPay ||
          body.token ||
          body.data?.tokenPay ||
          ""
        ).trim();


      if (!token) {

        console.warn(
          "MoneyFusion webhook: tokenPay manquant",
          body
        );

        return res.status(400).json({

          success: false,

          error: "tokenPay manquant"

        });
      }


      /*
      |--------------------------------------------------------------------------
      | Recherche du paiement
      |--------------------------------------------------------------------------
      */

      const paymentRef =
        getDb()
          .collection("payments")
          .doc(token);


      const storedSnap =
        await paymentRef.get();


      if (!storedSnap.exists) {

        console.warn(
          "MoneyFusion webhook: transaction inconnue",
          token
        );

        return res.status(404).json({

          success: false,

          error: "Transaction inconnue"

        });
      }


      const stored =
        storedSnap.data();


      /*
      |--------------------------------------------------------------------------
      | Si déjà payé : ne pas réactiver
      |--------------------------------------------------------------------------
      */

      if (stored.status === "paid") {

        return res.json({

          success: true,

          processed: true,

          status: "paid",

          message:
            "Transaction déjà traitée"

        });
      }


      /*
      |--------------------------------------------------------------------------
      | Vérification auprès de MoneyFusion
      |--------------------------------------------------------------------------
      */

      const verified =
        await moneyFusion.checkPayment(
          token
        );


      const verifiedData =
        verified.data || {};


      /*
      |--------------------------------------------------------------------------
      | Statut MoneyFusion
      |--------------------------------------------------------------------------
      */

      const status =
        String(
          verifiedData.statut ||
          body.statut ||
          body.status ||
          ""
        ).toLowerCase();


      /*
      |--------------------------------------------------------------------------
      | PAIEMENT RÉUSSI
      |--------------------------------------------------------------------------
      */

      if (status === "paid") {

        /*
        | Activation du forfait
        */

        const subscription =
          await service.activateSubscription(
            stored.shopId,
            stored.plan,
            30
          );


        /*
        | Enregistrement définitif
        */

        await paymentRef.set({

          status: "paid",

          transaction:
            verifiedData,

          subscription,

          paidAt: timestamp(),

          updatedAt: timestamp()

        }, {
          merge: true
        });


        console.log(
          `MoneyFusion: abonnement ${stored.plan} activé pour ${stored.shopId}`
        );


        return res.json({

          success: true,

          processed: true,

          status: "paid"

        });
      }


      /*
      |--------------------------------------------------------------------------
      | PAIEMENT ÉCHOUÉ / ANNULÉ
      |--------------------------------------------------------------------------
      */

      const failedStatuses = [
        "failure",
        "no paid",
        "cancelled",
        "canceled"
      ];


      if (
        failedStatuses.includes(status)
      ) {

        await paymentRef.set({

          status: "failed",

          transaction:
            verifiedData,

          updatedAt: timestamp()

        }, {
          merge: true
        });


        return res.json({

          success: true,

          processed: true,

          status: "failed"

        });
      }


      /*
      |--------------------------------------------------------------------------
      | PAIEMENT EN ATTENTE
      |--------------------------------------------------------------------------
      */

      await paymentRef.set({

        status: "pending",

        transaction:
          verifiedData,

        updatedAt: timestamp()

      }, {
        merge: true
      });


      return res.json({

        success: true,

        processed: true,

        status: "pending"

      });


    } catch (e) {

      console.error(
        "MoneyFusion webhook error:",
        e
      );


      return res.status(400).json({

        success: false,

        error: e.message

      });
    }
  }
);


/*
|--------------------------------------------------------------------------
| ACTIVATION MANUELLE — DÉVELOPPEMENT UNIQUEMENT
|--------------------------------------------------------------------------
*/

router.post(
  "/:shopId/activate",
  async (req, res) => {

    try {

      if (
        process.env.NODE_ENV ===
        "production"
      ) {

        return res.status(403).json({

          success: false,

          error:
            "ROUTE_DESACTIVEE_EN_PRODUCTION"

        });
      }


      const subscription =
        await service.activateSubscription(

          req.params.shopId,

          req.body.plan ||
            "FREE",

          req.body.days ||
            30
        );


      res.json({

        success: true,

        subscription

      });


    } catch (e) {

      res.status(400).json({

        success: false,

        error: e.message

      });
    }
  }
);


