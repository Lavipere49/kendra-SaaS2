const { getDb, timestamp } = require("../config/firebase");
const { initializeShopSaaS } = require("./saasService");

const shopsRef = () => getDb().collection("shops");

async function createShop({
  ownerId,
  name,
  phone = "",
  plan = "FREE"
}) {
  if (!ownerId || !name) {
    throw new Error("ownerId et name sont obligatoires");
  }

  const ref = shopsRef().doc();

  const shop = {
    id: ref.id,
    ownerId: String(ownerId),
    name: String(name).trim(),
    phone: String(phone).trim(),
    plan,
    status: "active",
    createdAt: timestamp(),
    updatedAt: timestamp()
  };

  await ref.set(shop);

  await initializeShopSaaS(
    ref.id,
    String(ownerId),
    plan
  );

  return shop;
}

async function getShop(shopId) {
  if (!shopId) return null;

  const snap = await shopsRef()
    .doc(String(shopId))
    .get();

  return snap.exists
    ? {
        id: snap.id,
        ...snap.data()
      }
    : null;
}

async function updateShop(shopId, data) {
  if (!shopId) {
    throw new Error("shopId est obligatoire");
  }

  const clean = {
    ...data
  };

  delete clean.id;
  delete clean.ownerId;

  clean.updatedAt = timestamp();

  await shopsRef()
    .doc(String(shopId))
    .set(clean, {
      merge: true
    });

  return getShop(shopId);
}

async function getShopsByOwner(ownerId) {
  if (!ownerId) return [];

  const snap = await shopsRef()
    .where("ownerId", "==", String(ownerId))
    .get();

  return snap.docs.map(doc => ({
    id: doc.id,
    ...doc.data()
  }));
}

/**
 * Recherche une boutique à partir du Phone Number ID
 * fourni par Meta lorsqu'un message WhatsApp arrive.
 *
 * Structure Firestore attendue :
 *
 * shops/{shopId}/whatsapp
 * {
 *   phoneNumberId: "...",
 *   wabaId: "...",
 *   accessToken: "...",
 *   connected: true
 * }
 */
async function getShopByWhatsAppPhoneNumberId(
  phoneNumberId
) {
  if (!phoneNumberId) {
    return null;
  }

  const snap = await shopsRef()
    .where(
      "whatsapp.phoneNumberId",
      "==",
      String(phoneNumberId)
    )
    .limit(1)
    .get();

  if (snap.empty) {
    return null;
  }

  const doc = snap.docs[0];

  return {
    id: doc.id,
    ...doc.data()
  };
}

/**
 * Enregistre ou met à jour la configuration WhatsApp
 * d'une boutique.
 *
 * IMPORTANT :
 * Le token Meta est stocké dans Firestore et n'est
 * jamais envoyé au frontend.
 */
async function saveWhatsAppConfig(
  shopId,
  {
    phoneNumberId,
    wabaId,
    accessToken,
    connected = true
  }
) {
  if (!shopId) {
    throw new Error("shopId est obligatoire");
  }

  if (!phoneNumberId) {
    throw new Error("phoneNumberId est obligatoire");
  }

  if (!accessToken) {
    throw new Error("accessToken est obligatoire");
  }

  const ref = shopsRef().doc(String(shopId));

  const snap = await ref.get();

  if (!snap.exists) {
    throw new Error("BOUTIQUE_NOT_FOUND");
  }

  await ref.set(
    {
      whatsapp: {
        phoneNumberId: String(phoneNumberId),
        wabaId: String(wabaId || ""),
        accessToken: String(accessToken),
        connected: Boolean(connected),
        connectedAt: timestamp(),
        updatedAt: timestamp()
      },
      updatedAt: timestamp()
    },
    {
      merge: true
    }
  );

  return getShop(shopId);
}

/**
 * Récupère uniquement la configuration WhatsApp
 * d'une boutique.
 */
async function getWhatsAppConfig(shopId) {
  const shop = await getShop(shopId);

  if (!shop) {
    throw new Error("BOUTIQUE_NOT_FOUND");
  }

  if (!shop.whatsapp) {
    return null;
  }

  return shop.whatsapp;
}

/**
 * Trouve la boutique actuellement configurée.
 */
async function resolveCurrentShop() {
  const configured = String(
    process.env.KENDRA_SHOP_ID || ""
  ).trim();

  if (configured) {
    const s = await getShop(configured);

    if (!s) {
      throw new Error(
        "KENDRA_SHOP_CONFIGURED_SHOP_NOT_FOUND"
      );
    }

    return s;
  }

  const snap = await shopsRef()
    .where("status", "==", "active")
    .limit(2)
    .get();

  if (snap.size === 1) {
    const d = snap.docs[0];

    return {
      id: d.id,
      ...d.data()
    };
  }

  if (snap.size === 0) {
    throw new Error(
      "KENDRA_NO_ACTIVE_SHOP"
    );
  }

  throw new Error(
    "KENDRA_SHOP_ID_REQUIRED_FOR_MULTIPLE_SHOPS"
  );
}

module.exports = {
  createShop,
  getShop,
  updateShop,
  getShopsByOwner,
  getShopByWhatsAppPhoneNumberId,
  saveWhatsAppConfig,
  getWhatsAppConfig,
  resolveCurrentShop
};
