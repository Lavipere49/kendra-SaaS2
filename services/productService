const { getDb, timestamp } = require("../config/firebase");
const subscriptionService = require("./subscriptionService");

const productsRef = (shopId) =>
  getDb()
    .collection("products")
    .where(
      "shopId",
      "==",
      String(shopId)
    );

/*
|--------------------------------------------------------------------------
| CRÉER UN PRODUIT
|--------------------------------------------------------------------------
*/

async function createProduct(
  shopId,
  data = {}
) {
  if (!shopId) {
    throw new Error(
      "shopId est obligatoire"
    );
  }

  const name =
    String(
      data.name || ""
    ).trim();

  if (!name) {
    throw new Error(
      "Le nom du produit est obligatoire"
    );
  }

  const price =
    Number(data.price);

  if (
    data.price === undefined ||
    !Number.isFinite(price) ||
    price < 0
  ) {
    throw new Error(
      "Le prix du produit est invalide"
    );
  }

  const stock =
    Number(
      data.stock === undefined
        ? 0
        : data.stock
    );

  if (
    !Number.isFinite(stock) ||
    stock < 0
  ) {
    throw new Error(
      "Le stock du produit est invalide"
    );
  }

  const db =
    getDb();

  /*
   * Vérification de la limite du plan.
   */
  const limitCheck =
    await subscriptionService.canUse(
      shopId,
      "products",
      1
    );

  if (!limitCheck.allowed) {
    throw new Error(
      limitCheck.reason
    );
  }

  const ref =
    db
      .collection("products")
      .doc();

  const product = {
    id:
      ref.id,

    shopId:
      String(shopId),

    name,

    description:
      String(
        data.description || ""
      ).trim(),

    price,

    stock:
      Math.max(
        0,
        Math.floor(stock)
      ),

    category:
      String(
        data.category || ""
      ).trim(),

    imageUrl:
      String(
        data.imageUrl || ""
      ).trim(),

    active:
      data.active !== false,

    createdAt:
      timestamp(),

    updatedAt:
      timestamp()
  };

  await ref.set(
    product
  );

  await db
    .collection("usage")
    .doc(String(shopId))
    .set(
      {
        products:
          require("firebase-admin")
            .firestore
            .FieldValue
            .increment(1),

        updatedAt:
          timestamp()
      },
      {
        merge: true
      }
    );

  return product;
}

/*
|--------------------------------------------------------------------------
| RÉCUPÉRER UN PRODUIT
|--------------------------------------------------------------------------
*/

async function getProduct(
  shopId,
  productId
) {
  if (
    !shopId ||
    !productId
  ) {
    return null;
  }

  const snap =
    await getDb()
      .collection("products")
      .doc(String(productId))
      .get();

  if (!snap.exists) {
    return null;
  }

  const data =
    snap.data();

  if (
    String(data.shopId) !==
    String(shopId)
  ) {
    return null;
  }

  return {
    id:
      snap.id,

    ...data
  };
}

/*
|--------------------------------------------------------------------------
| LISTE DES PRODUITS
|--------------------------------------------------------------------------
*/

async function listProducts(
  shopId,
  options = {}
) {
  if (!shopId) {
    return [];
  }

  const snap =
    await productsRef(
      shopId
    ).get();

  let products =
    snap.docs.map(
      doc => ({
        id:
          doc.id,

        ...doc.data()
      })
    );

  /*
   * Seulement les produits actifs.
   */
  if (
    options.activeOnly === true
  ) {
    products =
      products.filter(
        product =>
          product.active === true
      );
  }

  /*
   * Filtre catégorie.
   */
  if (
    options.category
  ) {
    const category =
      String(
        options.category
      )
        .trim()
        .toLowerCase();

    products =
      products.filter(
        product =>
          String(
            product.category || ""
          )
            .toLowerCase() ===
          category
      );
  }

  return products;
}

/*
|--------------------------------------------------------------------------
| UPLOAD IMAGE CLOUDINARY
|--------------------------------------------------------------------------
*/

async function uploadProductImage(
  shopId,
  dataUrl,
  fileName = "product"
) {
  if (!shopId) {
    throw new Error(
      "shopId est obligatoire"
    );
  }

  if (!dataUrl) {
    throw new Error(
      "Image manquante"
    );
  }

  const cloudinary =
    require(
      "./cloudinaryService"
    );

  return cloudinary.uploadImage({
    dataUrl,
    shopId,
    fileName
  });
}

/*
|--------------------------------------------------------------------------
| MODIFIER UN PRODUIT
|--------------------------------------------------------------------------
*/

async function updateProduct(
  shopId,
  productId,
  data = {}
) {
  const product =
    await getProduct(
      shopId,
      productId
    );

  if (!product) {
    return null;
  }

  const allowed = [
    "name",
    "description",
    "price",
    "stock",
    "category",
    "imageUrl",
    "active"
  ];

  const update = {};

  for (
    const key of allowed
  ) {
    if (
      data[key] !==
      undefined
    ) {
      update[key] =
        data[key];
    }
  }

  /*
   * Prix.
   */
  if (
    update.price !==
    undefined
  ) {
    update.price =
      Number(
        update.price
      );

    if (
      !Number.isFinite(
        update.price
      ) ||
      update.price < 0
    ) {
      throw new Error(
        "Le prix est invalide"
      );
    }
  }

  /*
   * Stock.
   */
  if (
    update.stock !==
    undefined
  ) {
    update.stock =
      Number(
        update.stock
      );

    if (
      !Number.isFinite(
        update.stock
      ) ||
      update.stock < 0
    ) {
      throw new Error(
        "Le stock est invalide"
      );
    }

    update.stock =
      Math.floor(
        update.stock
      );
  }

  /*
   * Texte.
   */
  if (
    update.name !==
    undefined
  ) {
    update.name =
      String(
        update.name
      ).trim();

    if (!update.name) {
      throw new Error(
        "Le nom du produit est obligatoire"
      );
    }
  }

  if (
    update.description !==
    undefined
  ) {
    update.description =
      String(
        update.description
      ).trim();
  }

  if (
    update.category !==
    undefined
  ) {
    update.category =
      String(
        update.category
      ).trim();
  }

  if (
    update.imageUrl !==
    undefined
  ) {
    update.imageUrl =
      String(
        update.imageUrl
      ).trim();
  }

  update.updatedAt =
    timestamp();

  await getDb()
    .collection("products")
    .doc(String(productId))
    .update(update);

  return getProduct(
    shopId,
    productId
  );
}

/*
|--------------------------------------------------------------------------
| SUPPRIMER UN PRODUIT
|--------------------------------------------------------------------------
*/

async function deleteProduct(
  shopId,
  productId
) {
  const product =
    await getProduct(
      shopId,
      productId
    );

  if (!product) {
    return false;
  }

  const db =
    getDb();

  await db
    .collection("products")
    .doc(String(productId))
    .delete();

  /*
   * Décrémenter le compteur.
   */
  const admin =
    require("firebase-admin");

  await db
    .collection("usage")
    .doc(String(shopId))
    .set(
      {
        products:
          admin.firestore
            .FieldValue
            .increment(-1),

        updatedAt:
          timestamp()
      },
      {
        merge: true
      }
    );

  return true;
}

/*
|--------------------------------------------------------------------------
| METTRE À JOUR LE STOCK
|--------------------------------------------------------------------------
*/

async function updateStock(
  shopId,
  productId,
  stock
) {
  return updateProduct(
    shopId,
    productId,
    {
      stock
    }
  );
}

/*
|--------------------------------------------------------------------------
| EXPORTS
|--------------------------------------------------------------------------
*/

module.exports = {
  createProduct,
  uploadProductImage,
  getProduct,
  listProducts,
  updateProduct,
  deleteProduct,
  updateStock
};
