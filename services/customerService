const { getDb, timestamp } = require("../config/firebase");

const customersRef = (shopId) =>
  getDb().collection("customers").where("shopId", "==", String(shopId));

async function createCustomer(shopId, data) {
  if (!shopId) throw new Error("shopId est obligatoire");
  if (!data.phone && !data.whatsapp) {
    throw new Error("phone ou whatsapp est obligatoire");
  }

  const db = getDb();
  const ref = db.collection("customers").doc();

  const customer = {
    id: ref.id,
    shopId: String(shopId),
    name: String(data.name || "").trim(),
    phone: String(data.phone || "").trim(),
    whatsapp: String(data.whatsapp || data.phone || "").trim(),
    email: String(data.email || "").trim(),
    address: String(data.address || "").trim(),
    notes: String(data.notes || "").trim(),
    totalOrders: 0,
    totalSpent: 0,
    lastContactAt: timestamp(),
    createdAt: timestamp(),
    updatedAt: timestamp()
  };

  await ref.set(customer);

  await db.collection("usage").doc(String(shopId)).set({
    customers: require("firebase-admin").firestore.FieldValue.increment(1),
    updatedAt: timestamp()
  }, { merge: true });

  return customer;
}

async function getCustomer(shopId, customerId) {
  const snap = await getDb().collection("customers").doc(customerId).get();
  if (!snap.exists || snap.data().shopId !== String(shopId)) return null;
  return { id: snap.id, ...snap.data() };
}

async function listCustomers(shopId) {
  const snap = await customersRef(shopId).get();
  return snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
}

async function findByWhatsApp(shopId, whatsapp) {
  const customers = await listCustomers(shopId);
  return customers.find(c => c.whatsapp === String(whatsapp)) || null;
}

async function updateCustomer(shopId, customerId, data) {
  const customer = await getCustomer(shopId, customerId);
  if (!customer) return null;

  const allowed = ["name","phone","whatsapp","email","address","notes"];
  const update = {};
  for (const key of allowed) {
    if (data[key] !== undefined) update[key] = String(data[key]).trim();
  }
  update.updatedAt = timestamp();

  await getDb().collection("customers").doc(customerId).update(update);
  return getCustomer(shopId, customerId);
}

module.exports = {
  createCustomer,
  getCustomer,
  listCustomers,
  findByWhatsApp,
  updateCustomer
};
