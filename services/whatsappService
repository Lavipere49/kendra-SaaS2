const {
  getShop,
  getWhatsAppConfig,
  saveWhatsAppConfig,
  updateShop
} = require("./shopService");

const META_GRAPH_VERSION =
  process.env.META_GRAPH_VERSION || "v23.0";

const META_GRAPH_URL =
  `https://graph.facebook.com/${META_GRAPH_VERSION}`;

/*
|--------------------------------------------------------------------------
| TOKENS META
|--------------------------------------------------------------------------
*/

/**
 * Token système Kendra.
 *
 * Il sert principalement à la configuration globale
 * et au fallback du compte de test.
 */
function getSystemToken() {
  const token = String(
    process.env.META_SYSTEM_USER_ACCESS_TOKEN || ""
  ).trim();

  if (!token) {
    throw new Error(
      "META_SYSTEM_USER_ACCESS_TOKEN_MANQUANT"
    );
  }

  return token;
}

/**
 * Compatibilité avec l'ancien nom utilisé ailleurs.
 */
function getMetaToken() {
  return getSystemToken();
}

/**
 * WABA global Kendra.
 *
 * Utilisé uniquement pour le compte de test/fallback.
 */
function getWabaId() {
  const wabaId = String(
    process.env.META_WABA_ID || ""
  ).trim();

  if (!wabaId) {
    throw new Error(
      "META_WABA_ID_MANQUANT"
    );
  }

  return wabaId;
}

/**
 * Phone Number ID global Kendra.
 *
 * Utilisé uniquement pour le compte de test/fallback.
 */
function getPhoneNumberId() {
  const phoneNumberId = String(
    process.env.META_PHONE_NUMBER_ID || ""
  ).trim();

  if (!phoneNumberId) {
    throw new Error(
      "META_PHONE_NUMBER_ID_MANQUANT"
    );
  }

  return phoneNumberId;
}

/*
|--------------------------------------------------------------------------
| APPEL GRAPH API
|--------------------------------------------------------------------------
*/

async function metaRequest(
  path,
  options = {}
) {
  const token = getSystemToken();

  return metaRequestWithToken(
    path,
    token,
    options
  );
}

async function metaRequestWithToken(
  path,
  token,
  options = {}
) {
  if (!token) {
    throw new Error(
      "META_ACCESS_TOKEN_MANQUANT"
    );
  }

  const url =
    `${META_GRAPH_URL}${path}`;

  const response = await fetch(
    url,
    {
      ...options,

      headers: {
        Authorization:
          `Bearer ${token}`,

        "Content-Type":
          "application/json",

        ...(options.headers || {})
      }
    }
  );

  const data =
    await response
      .json()
      .catch(() => ({}));

  if (!response.ok) {
    console.error(
      "Erreur Meta Graph API:",
      JSON.stringify(
        data,
        null,
        2
      )
    );

    throw new Error(
      data?.error?.message ||
      data?.error?.error_user_msg ||
      `META_API_ERROR_${response.status}`
    );
  }

  return data;
}

/*
|--------------------------------------------------------------------------
| INFORMATIONS WABA
|--------------------------------------------------------------------------
*/

async function getWabaInfo() {
  const wabaId =
    getWabaId();

  return metaRequest(
    `/${encodeURIComponent(wabaId)}` +
    `?fields=id,name`
  );
}

/*
|--------------------------------------------------------------------------
| INFORMATIONS NUMÉRO WHATSAPP
|--------------------------------------------------------------------------
*/

async function getPhoneNumberInfo() {
  const phoneNumberId =
    getPhoneNumberId();

  return metaRequest(
    `/${encodeURIComponent(phoneNumberId)}` +
    `?fields=id,display_phone_number,verified_name`
  );
}

/*
|--------------------------------------------------------------------------
| VÉRIFIER LA CONFIGURATION META GLOBALE
|--------------------------------------------------------------------------
*/

async function verifyMetaConfiguration() {
  const waba =
    await getWabaInfo();

  const phone =
    await getPhoneNumberInfo();

  return {
    success: true,

    waba: {
      id:
        waba.id || "",

      name:
        waba.name || ""
    },

    phone: {
      id:
        phone.id || "",

      displayPhoneNumber:
        phone.display_phone_number || "",

      verifiedName:
        phone.verified_name || ""
    }
  };
}

/*
|--------------------------------------------------------------------------
| ÉCHANGE DU CODE EMBEDDED SIGNUP
|--------------------------------------------------------------------------
|
| Meta retourne un "code" temporaire au frontend.
|
| Le backend échange ce code contre le business
| access token de la boutique cliente.
|
|--------------------------------------------------------------------------
*/

async function exchangeEmbeddedSignupCode(
  code
) {
  const appId =
    String(
      process.env.META_APP_ID || ""
    ).trim();

  const appSecret =
    String(
      process.env.META_APP_SECRET || ""
    ).trim();

  if (!appId || !appSecret) {
    throw new Error(
      "META_APP_CREDENTIALS_MANQUANTS"
    );
  }

  if (!code) {
    throw new Error(
      "META_EMBEDDED_SIGNUP_CODE_MANQUANT"
    );
  }

  const params =
    new URLSearchParams({
      client_id:
        appId,

      client_secret:
        appSecret,

      code:
        String(code)
    });

  const response =
    await fetch(
      `${META_GRAPH_URL}/oauth/access_token?${params.toString()}`,
      {
        method: "GET"
      }
    );

  const data =
    await response
      .json()
      .catch(() => ({}));

  if (
    !response.ok ||
    !data.access_token
  ) {
    console.error(
      "META CODE EXCHANGE ERROR:",
      JSON.stringify(
        data,
        null,
        2
      )
    );

    throw new Error(
      data?.error?.message ||
      data?.error?.error_user_msg ||
      "META_EMBEDDED_SIGNUP_CODE_EXCHANGE_FAILED"
    );
  }

  return String(
    data.access_token
  );
}

/*
|--------------------------------------------------------------------------
| NUMÉROS D'UN WABA
|--------------------------------------------------------------------------
*/

async function getWabaPhoneNumbers(
  wabaId,
  accessToken
) {
  if (!wabaId) {
    throw new Error(
      "META_WABA_ID_MANQUANT"
    );
  }

  return metaRequestWithToken(
    `/${encodeURIComponent(wabaId)}` +
    `/phone_numbers` +
    `?fields=id,display_phone_number,verified_name`,
    accessToken
  );
}

/*
|--------------------------------------------------------------------------
| SOUSCRIPTION DU WABA AUX WEBHOOKS
|--------------------------------------------------------------------------
*/

async function subscribeAppToWaba(
  wabaId,
  accessToken
) {
  if (!wabaId) {
    throw new Error(
      "META_WABA_ID_MANQUANT"
    );
  }

  return metaRequestWithToken(
    `/${encodeURIComponent(wabaId)}` +
    `/subscribed_apps`,
    accessToken,
    {
      method: "POST"
    }
  );
}

/*
|--------------------------------------------------------------------------
| CONNEXION WHATSAPP
|--------------------------------------------------------------------------
|
| Deux modes :
|
| 1. EMBEDDED SIGNUP
|    - code
|    - wabaId
|    - phoneNumberId
|
| 2. FALLBACK TEST
|    - variables Render
|
|--------------------------------------------------------------------------
*/

async function connectWhatsApp(
  shopId,
  options = {}
) {
  if (!shopId) {
    throw new Error(
      "SHOP_ID_MANQUANT"
    );
  }

  const shop =
    await getShop(shopId);

  if (!shop) {
    throw new Error(
      "BOUTIQUE_NOT_FOUND"
    );
  }

  const code =
    String(
      options.code || ""
    ).trim();

  let accessToken =
    "";

  let wabaId =
    String(
      options.wabaId || ""
    ).trim();

  let phoneNumberId =
    String(
      options.phoneNumberId || ""
    ).trim();

  /*
   * ---------------------------------------------------------------
   * MODE EMBEDDED SIGNUP
   * ---------------------------------------------------------------
   */

  if (code) {
    accessToken =
      await exchangeEmbeddedSignupCode(
        code
      );
  }

  /*
   * ---------------------------------------------------------------
   * MODE TEST / FALLBACK
   * ---------------------------------------------------------------
   */

  else {
    accessToken =
      getSystemToken();

    wabaId =
      wabaId ||
      getWabaId();

    phoneNumberId =
      phoneNumberId ||
      getPhoneNumberId();
  }

  /*
   * ---------------------------------------------------------------
   * WABA ID
   * ---------------------------------------------------------------
   */

  if (!wabaId) {
    throw new Error(
      "META_WABA_ID_MANQUANT"
    );
  }

  /*
   * ---------------------------------------------------------------
   * PHONE NUMBER ID
   * ---------------------------------------------------------------
   *
   * Normalement Embedded Signup fournit cet ID.
   *
   * Si absent, on le récupère depuis le WABA.
   */

  if (!phoneNumberId) {
    const numbers =
      await getWabaPhoneNumbers(
        wabaId,
        accessToken
      );

    const first =
      Array.isArray(
        numbers.data
      )
        ? numbers.data[0]
        : null;

    if (!first?.id) {
      throw new Error(
        "META_PHONE_NUMBER_ID_MANQUANT"
      );
    }

    phoneNumberId =
      String(first.id);
  }

  /*
   * ---------------------------------------------------------------
   * VÉRIFICATION DU WABA
   * ---------------------------------------------------------------
   */

  const waba =
    await metaRequestWithToken(
      `/${encodeURIComponent(wabaId)}` +
      `?fields=id,name`,
      accessToken
    );

  if (
    String(waba.id) !==
    String(wabaId)
  ) {
    throw new Error(
      "META_WABA_ID_INCORRECT"
    );
  }

  /*
   * ---------------------------------------------------------------
   * VÉRIFICATION DU NUMÉRO
   * ---------------------------------------------------------------
   */

  const phone =
    await metaRequestWithToken(
      `/${encodeURIComponent(phoneNumberId)}` +
      `?fields=id,display_phone_number,verified_name`,
      accessToken
    );

  if (
    String(phone.id) !==
    String(phoneNumberId)
  ) {
    throw new Error(
      "META_PHONE_NUMBER_ID_INCORRECT"
    );
  }

  /*
   * ---------------------------------------------------------------
   * ABONNEMENT DU WABA AUX WEBHOOKS
   * ---------------------------------------------------------------
   */

  await subscribeAppToWaba(
    wabaId,
    accessToken
  );

  /*
   * ---------------------------------------------------------------
   * SAUVEGARDE FIRESTORE
   * ---------------------------------------------------------------
   */

  await saveWhatsAppConfig(
    shopId,
    {
      phoneNumberId:
        phoneNumberId,

      wabaId:
        wabaId,

      accessToken:
        accessToken,

      connected:
        true
    }
  );

  /*
   * ---------------------------------------------------------------
   * MISE À JOUR DE LA BOUTIQUE
   * ---------------------------------------------------------------
   */

  await updateShop(
    shopId,
    {
      whatsappDisplayPhoneNumber:
        phone.display_phone_number ||
        options.phoneNumber ||
        "",

      whatsappVerifiedName:
        phone.verified_name ||
        "",

      whatsappWabaName:
        waba.name ||
        ""
    }
  );

  /*
   * ---------------------------------------------------------------
   * RÉSULTAT
   * ---------------------------------------------------------------
   */

  return {
    success:
      true,

    connected:
      true,

    wabaId:
      wabaId,

    phoneNumberId:
      phoneNumberId,

    phoneNumber:
      phone.display_phone_number ||
      options.phoneNumber ||
      "",

    verifiedName:
      phone.verified_name ||
      ""
  };
}

/*
|--------------------------------------------------------------------------
| STATUT WHATSAPP
|--------------------------------------------------------------------------
*/

async function getConnectionStatus(
  shopId
) {
  const shop =
    await getShop(shopId);

  if (!shop) {
    throw new Error(
      "BOUTIQUE_NOT_FOUND"
    );
  }

  const whatsapp =
    shop.whatsapp;

  if (
    !whatsapp ||
    !whatsapp.connected
  ) {
    return {
      connected:
        false,

      phoneNumber:
        "",

      phoneNumberId:
        "",

      wabaId:
        "",

      verifiedName:
        ""
    };
  }

  return {
    connected:
      true,

    phoneNumber:
      shop.whatsappDisplayPhoneNumber ||
      "",

    phoneNumberId:
      whatsapp.phoneNumberId ||
      "",

    wabaId:
      whatsapp.wabaId ||
      "",

    verifiedName:
      shop.whatsappVerifiedName ||
      ""
  };
}

/*
|--------------------------------------------------------------------------
| DÉCONNECTER WHATSAPP
|--------------------------------------------------------------------------
*/

async function disconnectWhatsApp(
  shopId
) {
  const shop =
    await getShop(shopId);

  if (!shop) {
    throw new Error(
      "BOUTIQUE_NOT_FOUND"
    );
  }

  /*
   * On retire uniquement la connexion
   * de cette boutique.
   *
   * Le token global Render reste intact.
   */

  await updateShop(
    shopId,
    {
      whatsapp: {
        phoneNumberId:
          "",

        wabaId:
          "",

        accessToken:
          "",

        connected:
          false,

        disconnectedAt:
          new Date().toISOString()
      },

      whatsappDisplayPhoneNumber:
        "",

      whatsappVerifiedName:
        "",

      whatsappWabaName:
        ""
    }
  );

  return {
    success:
      true,

    connected:
      false
  };
}

/*
|--------------------------------------------------------------------------
| ENVOYER UN MESSAGE WHATSAPP
|--------------------------------------------------------------------------
*/

async function sendMessage({
  shopId,
  to,
  text
}) {
  if (!shopId) {
    throw new Error(
      "shopId est obligatoire"
    );
  }

  if (!to) {
    throw new Error(
      "Destinataire WhatsApp manquant"
    );
  }

  if (!text) {
    throw new Error(
      "Message vide"
    );
  }

  /*
   * Configuration propre à la boutique.
   */

  const config =
    await getWhatsAppConfig(
      shopId
    );

  /*
   * Priorité absolue :
   *
   * 1. token de la boutique
   * 2. token système Kendra
   */

  const token =
    config?.accessToken ||
    getSystemToken();

  /*
   * Priorité :
   *
   * 1. Phone Number ID de la boutique
   * 2. Phone Number ID global de test
   */

  const phoneNumberId =
    config?.phoneNumberId ||
    getPhoneNumberId();

  if (!phoneNumberId) {
    throw new Error(
      "WHATSAPP_PHONE_NUMBER_ID_MISSING"
    );
  }

  if (!token) {
    throw new Error(
      "WHATSAPP_ACCESS_TOKEN_MISSING"
    );
  }

  const url =
    `${META_GRAPH_URL}/` +
    `${encodeURIComponent(phoneNumberId)}` +
    `/messages`;

  const response =
    await fetch(
      url,
      {
        method:
          "POST",

        headers: {
          Authorization:
            `Bearer ${token}`,

          "Content-Type":
            "application/json"
        },

        body:
          JSON.stringify({
            messaging_product:
              "whatsapp",

            recipient_type:
              "individual",

            to:
              String(to),

            type:
              "text",

            text: {
              preview_url:
                false,

              body:
                String(text)
            }
          })
      }
    );

  const data =
    await response
      .json()
      .catch(() => ({}));

  if (!response.ok) {
    console.error(
      "Erreur envoi WhatsApp:",
      JSON.stringify(
        data,
        null,
        2
      )
    );

    throw new Error(
      data?.error?.message ||
      data?.error?.error_user_msg ||
      "WHATSAPP_SEND_FAILED"
    );
  }

  return data;
}

/*
|--------------------------------------------------------------------------
| EXPORTS
|--------------------------------------------------------------------------
*/

module.exports = {
  getWabaInfo,
  getPhoneNumberInfo,
  verifyMetaConfiguration,
  connectWhatsApp,
  getConnectionStatus,
  disconnectWhatsApp,
  sendMessage
};
