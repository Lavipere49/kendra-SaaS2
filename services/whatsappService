const crypto = require("crypto");

const {
  getShop,
  getWhatsAppConfig,
  updateShop
} = require("./shopService");

const EVOLUTION_API_URL = String(
  process.env.EVOLUTION_API_URL || ""
).trim().replace(/\/$/, "");

const EVOLUTION_API_KEY = String(
  process.env.EVOLUTION_API_KEY || ""
).trim();

const EVOLUTION_INTEGRATION = String(
  process.env.EVOLUTION_INTEGRATION || "WHATSAPP-BAILEYS"
).trim();

const WEBHOOK_SECRET = String(
  process.env.EVOLUTION_WEBHOOK_SECRET || ""
).trim();

function requireEvolution() {
  if (!EVOLUTION_API_URL) {
    throw new Error("EVOLUTION_API_URL_MANQUANT");
  }
  if (!EVOLUTION_API_KEY) {
    throw new Error("EVOLUTION_API_KEY_MANQUANTE");
  }
}

function normalizeNumber(value) {
  return String(value || "")
    .replace(/[^0-9]/g, "")
    .trim();
}

function makeInstanceName(shopId) {
  const safeShop = String(shopId || "shop")
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "")
    .slice(0, 24) || "shop";
  const suffix = crypto.randomBytes(5).toString("hex");
  return `kendra_${safeShop}_${suffix}`;
}

function makeInstanceToken() {
  return crypto.randomBytes(32).toString("hex");
}

function webhookUrl() {
  const base = String(
    process.env.KENDRA_PUBLIC_URL ||
    process.env.BACKEND_PUBLIC_URL ||
    "https://kendra-saas2.onrender.com"
  ).trim().replace(/\/$/, "");

  const url = `${base}/api/whatsapp/evolution/webhook`;
  if (!WEBHOOK_SECRET) return url;
  return `${url}?secret=${encodeURIComponent(WEBHOOK_SECRET)}`;
}

async function evolutionRequest(path, options = {}, token = EVOLUTION_API_KEY) {
  requireEvolution();

  const url = `${EVOLUTION_API_URL}${path}`;
  const response = await fetch(url, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      apikey: token,
      ...(options.headers || {})
    }
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    const message =
      data?.response?.message ||
      data?.message ||
      data?.error ||
      `EVOLUTION_API_ERROR_${response.status}`;
    const error = new Error(String(message));
    error.status = response.status;
    error.data = data;
    throw error;
  }

  return data;
}

function extractQr(data) {
  const candidates = [
    data?.qrcode?.base64,
    data?.qrcode?.code,
    data?.qr?.base64,
    data?.qr?.code,
    data?.base64,
    data?.code,
    data?.response?.qrcode?.base64,
    data?.response?.qrcode?.code,
    data?.data?.qrcode?.base64,
    data?.data?.qrcode?.code,
    data?.data?.base64,
    data?.data?.code
  ];

  return candidates.find(v => typeof v === "string" && v.trim()) || "";
}

function extractPairingCode(data) {
  const candidates = [
    data?.pairingCode,
    data?.PairingCode,
    data?.code,
    data?.data?.pairingCode,
    data?.data?.PairingCode,
    data?.data?.code
  ];
  return candidates.find(v => typeof v === "string" && v.trim()) || "";
}

function extractState(data) {
  return String(
    data?.instance?.state ||
    data?.instance?.connectionStatus ||
    data?.state ||
    data?.status ||
    data?.data?.state ||
    data?.data?.status ||
    ""
  ).toLowerCase();
}

async function createInstance(shopId, shop) {
  const instanceName = makeInstanceName(shopId);
  const instanceToken = makeInstanceToken();
  const hook = webhookUrl();

  const body = {
    instanceName,
    token: instanceToken,
    integration: EVOLUTION_INTEGRATION,
    qrcode: true,
    webhook: {
      url: hook,
      byEvents: false,
      base64: true,
      events: [
        "QRCODE_UPDATED",
        "CONNECTION_UPDATE",
        "MESSAGES_UPSERT",
        "MESSAGES_UPDATE",
        "SEND_MESSAGE"
      ]
    }
  };

  let data;
  try {
    data = await evolutionRequest("/instance/create", {
      method: "POST",
      body: JSON.stringify(body)
    });
  } catch (error) {
    // Older Evolution API builds may reject the nested webhook/integration fields.
    data = await evolutionRequest("/instance/create", {
      method: "POST",
      body: JSON.stringify({
        instanceName,
        token: instanceToken,
        qrcode: true
      })
    });
  }

  const returnedToken = String(
    data?.hash?.apikey ||
    data?.hash?.jwt ||
    data?.instance?.token ||
    instanceToken
  ).trim();

  await configureWebhook(instanceName, returnedToken).catch(() => {});

  await updateShop(shopId, {
    whatsapp: {
      ...(shop.whatsapp || {}),
      connected: false,
      provider: "evolution",
      evolutionInstanceName: instanceName,
      evolutionInstanceToken: returnedToken,
      connectedAt: null,
      updatedAt: new Date().toISOString()
    },
    whatsappDisplayPhoneNumber: "",
    whatsappVerifiedName: "",
    whatsappWabaName: ""
  });

  return {
    instanceName,
    instanceToken: returnedToken,
    created: true
  };
}

async function configureWebhook(instanceName, instanceToken) {
  const hook = webhookUrl();
  const payload = {
    webhook: {
      enabled: true,
      url: hook,
      webhookByEvents: false,
      webhookBase64: true,
      events: [
        "QRCODE_UPDATED",
        "CONNECTION_UPDATE",
        "MESSAGES_UPSERT",
        "MESSAGES_UPDATE",
        "SEND_MESSAGE"
      ]
    }
  };

  try {
    return await evolutionRequest(
      `/webhook/set/${encodeURIComponent(instanceName)}`,
      { method: "POST", body: JSON.stringify(payload) },
      instanceToken
    );
  } catch (firstError) {
    // Some versions configure the webhook during /instance/connect instead.
    return { skipped: true, reason: firstError.message };
  }
}

async function getQr(instanceName, instanceToken) {
  const paths = [
    `/instance/connect/${encodeURIComponent(instanceName)}`,
    `/instance/qr/${encodeURIComponent(instanceName)}`
  ];

  let lastError;
  for (const path of paths) {
    try {
      const data = await evolutionRequest(path, { method: "GET" }, instanceToken);
      const qr = extractQr(data);
      if (qr) return { qr, raw: data };
    } catch (error) {
      lastError = error;
    }
  }

  throw lastError || new Error("EVOLUTION_QR_NON_DISPONIBLE");
}

async function startConnection(instanceName, instanceToken) {
  // Evolution API 2.x exposes the connection/QR endpoint as GET.
  // The previous implementation used POST here, which causes:
  // "Cannot POST /instance/connect/:instance".
  const path = `/instance/connect/${encodeURIComponent(instanceName)}`;

  try {
    return await evolutionRequest(
      path,
      { method: "GET" },
      instanceToken
    );
  } catch (error) {
    // If the instance is already connected/open, this is not a fatal error.
    const msg = String(error.message || "");
    if (/already|open|connected|logged/i.test(msg)) {
      return { success: true, alreadyConnected: true };
    }
    throw error;
  }
}

async function getState(instanceName, instanceToken) {
  const paths = [
    `/instance/connectionState/${encodeURIComponent(instanceName)}`,
    `/instance/fetchInstances?instanceName=${encodeURIComponent(instanceName)}`
  ];

  let lastError;
  for (const path of paths) {
    try {
      const data = await evolutionRequest(path, { method: "GET" }, instanceToken);
      const state = extractState(data);
      return { state, raw: data };
    } catch (error) {
      lastError = error;
    }
  }

  throw lastError || new Error("EVOLUTION_STATUS_FAILED");
}

async function connectWhatsApp(shopId, options = {}) {
  if (!shopId) throw new Error("SHOP_ID_MANQUANT");
  const shop = await getShop(shopId);
  if (!shop) throw new Error("BOUTIQUE_NOT_FOUND");

  let whatsapp = shop.whatsapp || {};
  let instanceName = String(whatsapp.evolutionInstanceName || "").trim();
  let instanceToken = String(whatsapp.evolutionInstanceToken || "").trim();

  if (!instanceName || !instanceToken) {
    const created = await createInstance(shopId, shop);
    instanceName = created.instanceName;
    instanceToken = created.instanceToken;
    whatsapp = (await getShop(shopId)).whatsapp || {};
  }

  await configureWebhook(instanceName, instanceToken).catch(() => {});

  // Start the session. Evolution API creates the QR asynchronously on some builds.
  try {
    await startConnection(instanceName, instanceToken);
  } catch (error) {
    const msg = String(error.message || "");
    if (!/already|open|connected|logged/i.test(msg)) throw error;
  }

  let qr = "";
  let qrError = null;
  for (let attempt = 0; attempt < 5; attempt++) {
    try {
      const result = await getQr(instanceName, instanceToken);
      qr = result.qr;
      if (qr) break;
    } catch (error) {
      qrError = error;
    }
    await new Promise(resolve => setTimeout(resolve, 1200));
  }

  const state = await getState(instanceName, instanceToken).catch(() => ({ state: "connecting" }));
  const connected = ["open", "connected", "online"].includes(state.state);

  await updateShop(shopId, {
    whatsapp: {
      ...(whatsapp || {}),
      provider: "evolution",
      evolutionInstanceName: instanceName,
      evolutionInstanceToken: instanceToken,
      connected,
      updatedAt: new Date().toISOString()
    }
  });

  return {
    success: true,
    connected,
    provider: "evolution",
    instanceName,
    phoneNumber: String(options.phoneNumber || shop.whatsappDisplayPhoneNumber || "").trim(),
    qr: qr || "",
    qrError: qr ? "" : (qrError?.message || "QR_EN_ATTENTE"),
    state: state.state || "connecting"
  };
}

async function requestPairingCode(shopId, phone) {
  const shop = await getShop(shopId);
  if (!shop) throw new Error("BOUTIQUE_NOT_FOUND");

  const number = normalizeNumber(phone);
  if (!number) throw new Error("NUMERO_WHATSAPP_MANQUANT");

  const whatsapp = shop.whatsapp || {};
  const instanceName = String(whatsapp.evolutionInstanceName || "").trim();
  const instanceToken = String(whatsapp.evolutionInstanceToken || "").trim();
  if (!instanceName || !instanceToken) {
    throw new Error("INSTANCE_EVOLUTION_MANQUANTE");
  }

  // Evolution API 2.x commonly supports /instance/connect/{instance}?number=...
  const encoded = encodeURIComponent(instanceName);
  const attempts = [
    {
      path: `/instance/connect/${encoded}?number=${encodeURIComponent(number)}`,
      method: "GET"
    }
  ];

  let lastError;
  for (const attempt of attempts) {
    try {
      const data = await evolutionRequest(attempt.path, {
        method: attempt.method,
        body: attempt.body
      }, instanceToken);
      const code = extractPairingCode(data);
      if (code) {
        await updateShop(shopId, {
          whatsappDisplayPhoneNumber: number,
          whatsapp: {
            ...whatsapp,
            provider: "evolution",
            evolutionPhoneNumber: number,
            updatedAt: new Date().toISOString()
          }
        });
        return { success: true, pairingCode: code };
      }
    } catch (error) {
      lastError = error;
    }
  }

  throw lastError || new Error("EVOLUTION_PAIRING_CODE_NON_DISPONIBLE");
}

async function getConnectionStatus(shopId) {
  const shop = await getShop(shopId);
  if (!shop) throw new Error("BOUTIQUE_NOT_FOUND");

  const whatsapp = shop.whatsapp || {};
  const instanceName = String(whatsapp.evolutionInstanceName || "").trim();
  const instanceToken = String(whatsapp.evolutionInstanceToken || "").trim();

  if (!instanceName || !instanceToken) {
    return {
      connected: false,
      provider: "evolution",
      phoneNumber: "",
      instanceName: ""
    };
  }

  const result = await getState(instanceName, instanceToken).catch(() => ({ state: "" }));
  const state = String(result.state || "").toLowerCase();
  const connected = ["open", "connected", "online"].includes(state);

  if (connected !== Boolean(whatsapp.connected)) {
    await updateShop(shopId, {
      whatsapp: {
        ...whatsapp,
        provider: "evolution",
        connected,
        updatedAt: new Date().toISOString()
      }
    });
  }

  return {
    connected,
    provider: "evolution",
    state,
    phoneNumber:
      shop.whatsappDisplayPhoneNumber ||
      whatsapp.evolutionPhoneNumber ||
      "",
    instanceName
  };
}

async function disconnectWhatsApp(shopId) {
  const shop = await getShop(shopId);
  if (!shop) throw new Error("BOUTIQUE_NOT_FOUND");

  const whatsapp = shop.whatsapp || {};
  const instanceName = String(whatsapp.evolutionInstanceName || "").trim();
  const instanceToken = String(whatsapp.evolutionInstanceToken || "").trim();

  if (instanceName && instanceToken) {
    try {
      await evolutionRequest(
        `/instance/logout/${encodeURIComponent(instanceName)}`,
        { method: "DELETE" },
        instanceToken
      );
    } catch (error) {
      console.warn("Evolution logout:", error.message);
    }
  }

  await updateShop(shopId, {
    whatsapp: {
      provider: "evolution",
      evolutionInstanceName: "",
      evolutionInstanceToken: "",
      evolutionPhoneNumber: "",
      connected: false,
      disconnectedAt: new Date().toISOString()
    },
    whatsappDisplayPhoneNumber: "",
    whatsappVerifiedName: "",
    whatsappWabaName: ""
  });

  return { success: true, connected: false };
}

async function sendMessage({ shopId, to, text }) {
  if (!shopId) throw new Error("shopId est obligatoire");
  if (!to) throw new Error("Destinataire WhatsApp manquant");
  if (!text) throw new Error("Message vide");

  const shop = await getShop(shopId);
  if (!shop) throw new Error("BOUTIQUE_NOT_FOUND");

  const whatsapp = shop.whatsapp || {};
  const instanceName = String(whatsapp.evolutionInstanceName || "").trim();
  const instanceToken = String(whatsapp.evolutionInstanceToken || "").trim();
  if (!instanceName || !instanceToken) {
    throw new Error("WHATSAPP_EVOLUTION_NON_CONNECTE");
  }

  const number = normalizeNumber(to);
  const body = JSON.stringify({
    number,
    text: String(text),
    delay: 0,
    linkPreview: false
  });

  const paths = [
    `/message/sendText/${encodeURIComponent(instanceName)}`,
    `/send/text/${encodeURIComponent(instanceName)}`
  ];

  let lastError;
  for (const path of paths) {
    try {
      return await evolutionRequest(path, {
        method: "POST",
        body
      }, instanceToken);
    } catch (error) {
      lastError = error;
    }
  }

  throw lastError || new Error("WHATSAPP_SEND_FAILED");
}

function normalizeEvolutionWebhook(body) {
  const event = String(body?.event || body?.type || "").toUpperCase();
  const instance = String(
    body?.instance ||
    body?.instanceName ||
    body?.data?.instance ||
    ""
  ).trim();
  const data = body?.data || body;

  const message =
    data?.message ||
    data?.messages?.[0] ||
    data?.Message ||
    null;

  const key =
    data?.key ||
    data?.Key ||
    data?.Info ||
    message?.key ||
    message?.Key ||
    {};

  const remoteJid = String(
    key?.remoteJid ||
    key?.RemoteJid ||
    data?.remoteJid ||
    data?.sender ||
    ""
  ).trim();

  const fromMe = Boolean(
    key?.fromMe ??
    key?.FromMe ??
    data?.fromMe
  );

  const text = String(
    message?.conversation ||
    message?.extendedTextMessage?.text ||
    message?.extendedTextMessage?.Text ||
    data?.text ||
    data?.body ||
    ""
  ).trim();

  return { event, instance, remoteJid, fromMe, text };
}

module.exports = {
  connectWhatsApp,
  requestPairingCode,
  getConnectionStatus,
  disconnectWhatsApp,
  sendMessage,
  normalizeEvolutionWebhook
};
