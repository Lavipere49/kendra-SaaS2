const { getDb, timestamp } = require("../config/firebase");
const { createShop } = require("./shopService");

function cleanEmail(email) {
  return String(email || "").trim().toLowerCase();
}

async function registerMerchant({ name, shopName, email, phone = "", password }) {
  name = String(name || "").trim();
  shopName = String(shopName || "").trim();
  email = cleanEmail(email);
  phone = String(phone || "").trim();
  password = String(password || "");

  if (!name || !shopName || !email || !password) {
    throw new Error("Nom, boutique, email et mot de passe sont obligatoires.");
  }
  if (password.length < 6) throw new Error("Le mot de passe doit contenir au moins 6 caractères.");

  const admin = require("../config/firebase").admin;
  let user;
  try {
    user = await admin.auth().createUser({
      email,
      password,
      displayName: name
    });
  } catch (e) {
    if (e.code === "auth/email-already-exists") throw new Error("Un compte existe déjà avec cet email.");
    throw e;
  }

  try {
    const db = getDb();
    const shop = await createShop({ ownerId: user.uid, name: shopName, phone, plan: "FREE" });
    await db.collection("users").doc(user.uid).set({
      uid: user.uid,
      name,
      email,
      phone,
      role: "merchant",
      shopId: shop.id,
      createdAt: timestamp(),
      updatedAt: timestamp()
    });
    return { uid: user.uid, shopId: shop.id, email, name, shopName };
  } catch (e) {
    // Roll back the Auth user if the Firestore/shop initialization failed.
    try { await admin.auth().deleteUser(user.uid); } catch (_) {}
    throw e;
  }
}

async function loginMerchant({ email, password }) {
  const apiKey = String(process.env.FIREBASE_WEB_API_KEY || "").trim();
  if (!apiKey) throw new Error("FIREBASE_WEB_API_KEY n'est pas configurée sur le serveur.");

  const response = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${encodeURIComponent(apiKey)}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email: cleanEmail(email), password: String(password || ""), returnSecureToken: true })
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    const messages = {
      INVALID_LOGIN_CREDENTIALS: "Email ou mot de passe incorrect.",
      EMAIL_NOT_FOUND: "Email ou mot de passe incorrect.",
      INVALID_PASSWORD: "Email ou mot de passe incorrect.",
      USER_DISABLED: "Ce compte a été désactivé."
    };
    throw new Error(messages[data.error?.message] || "Connexion impossible.");
  }

  const admin = require("../config/firebase").admin;
  const decoded = await admin.auth().verifyIdToken(data.idToken);
  const snap = await getDb().collection("users").doc(decoded.uid).get();
  if (!snap.exists) throw new Error("Profil commerçant introuvable.");
  const profile = snap.data();
  if (profile.role !== "merchant") throw new Error("Ce compte n'est pas un compte commerçant.");

  return {
    idToken: data.idToken,
    refreshToken: data.refreshToken,
    expiresIn: data.expiresIn,
    uid: decoded.uid,
    profile
  };
}

module.exports = { registerMerchant, loginMerchant };
