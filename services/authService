const { getDb, timestamp, admin } = require("../config/firebase");
const { createShop } = require("./shopService");

function cleanEmail(email) {
  return String(email || "")
    .trim()
    .toLowerCase();
}

function cleanText(value) {
  return String(value || "").trim();
}

async function signInWithFirebase(email, password) {
  const apiKey = String(
    process.env.FIREBASE_WEB_API_KEY || ""
  ).trim();

  if (!apiKey) {
    throw new Error(
      "FIREBASE_WEB_API_KEY n'est pas configurée sur le serveur."
    );
  }

  const response = await fetch(
    `https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${encodeURIComponent(
      apiKey
    )}`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        email,
        password,
        returnSecureToken: true
      })
    }
  );

  const data = await response
    .json()
    .catch(() => ({}));

  if (!response.ok) {
    const messages = {
      INVALID_LOGIN_CREDENTIALS:
        "Email ou mot de passe incorrect.",

      EMAIL_NOT_FOUND:
        "Email ou mot de passe incorrect.",

      INVALID_PASSWORD:
        "Email ou mot de passe incorrect.",

      USER_DISABLED:
        "Ce compte a été désactivé."
    };

    throw new Error(
      messages[data.error?.message] ||
      data.error?.message ||
      "Connexion impossible."
    );
  }

  return data;
}

async function deleteMerchantData(uid, shopId) {
  const db = getDb();

  /*
   * Suppression du profil utilisateur.
   */
  if (uid) {
    await db
      .collection("users")
      .doc(uid)
      .delete()
      .catch(() => {});
  }

  /*
   * Suppression des données SaaS créées automatiquement.
   */
  if (shopId) {
    const collections = [
      "subscriptions",
      "usage"
    ];

    for (const collection of collections) {
      await db
        .collection(collection)
        .doc(String(shopId))
        .delete()
        .catch(() => {});
    }

    /*
     * Suppression de la boutique.
     */
    await db
      .collection("shops")
      .doc(String(shopId))
      .delete()
      .catch(() => {});
  }
}

/**
 * =========================================================
 * INSCRIPTION COMMERÇANT
 * =========================================================
 *
 * 1. Création Firebase Auth
 * 2. Création automatique boutique
 * 3. Création automatique profil
 * 4. Création automatique SaaS
 * 5. Connexion automatique
 * 6. Retour des tokens
 */
async function registerMerchant({
  name,
  shopName,
  email,
  phone = "",
  password
}) {
  const cleanName = cleanText(name);
  const cleanShopName = cleanText(shopName);
  const cleanUserEmail = cleanEmail(email);
  const cleanPhone = cleanText(phone);
  const cleanPassword = String(password || "");

  if (
    !cleanName ||
    !cleanShopName ||
    !cleanUserEmail ||
    !cleanPassword
  ) {
    throw new Error(
      "Nom, boutique, email et mot de passe sont obligatoires."
    );
  }

  if (cleanPassword.length < 6) {
    throw new Error(
      "Le mot de passe doit contenir au moins 6 caractères."
    );
  }

  let user = null;
  let shop = null;

  /*
   * =======================================================
   * 1. FIREBASE AUTH
   * =======================================================
   */
  try {
    user = await admin.auth().createUser({
      email: cleanUserEmail,
      password: cleanPassword,
      displayName: cleanName
    });
  } catch (error) {
    if (error.code === "auth/email-already-exists") {
      throw new Error(
        "Un compte existe déjà avec cet email."
      );
    }

    throw error;
  }

  try {
    /*
     * =====================================================
     * 2. BOUTIQUE
     * =====================================================
     */
    shop = await createShop({
      ownerId: user.uid,
      name: cleanShopName,
      phone: cleanPhone,
      plan: "FREE"
    });

    /*
     * =====================================================
     * 3. PROFIL COMMERÇANT
     * =====================================================
     */
    const db = getDb();

    await db
      .collection("users")
      .doc(user.uid)
      .set({
        uid: user.uid,
        name: cleanName,
        email: cleanUserEmail,
        phone: cleanPhone,
        role: "merchant",
        shopId: shop.id,
        createdAt: timestamp(),
        updatedAt: timestamp()
      });

    /*
     * =====================================================
     * 4. CONNEXION AUTOMATIQUE
     * =====================================================
     */
    const authData = await signInWithFirebase(
      cleanUserEmail,
      cleanPassword
    );

    /*
     * =====================================================
     * 5. VÉRIFICATION DU TOKEN
     * =====================================================
     */
    const decoded = await admin
      .auth()
      .verifyIdToken(authData.idToken);

    if (decoded.uid !== user.uid) {
      throw new Error(
        "Erreur de vérification du compte."
      );
    }

    /*
     * =====================================================
     * 6. RETOUR FRONTEND
     * =====================================================
     */
    return {
      uid: user.uid,
      shopId: shop.id,
      email: cleanUserEmail,
      name: cleanName,
      shopName: cleanShopName,

      idToken: authData.idToken,
      refreshToken: authData.refreshToken,
      expiresIn: authData.expiresIn
    };

  } catch (error) {
    /*
     * =====================================================
     * ROLLBACK COMPLET
     * =====================================================
     */

    await deleteMerchantData(
      user.uid,
      shop?.id
    );

    try {
      await admin.auth().deleteUser(user.uid);
    } catch (_) {
      // Rien à faire si Firebase Auth ne peut pas supprimer l'utilisateur.
    }

    throw error;
  }
}

/**
 * =========================================================
 * CONNEXION COMMERÇANT
 * =========================================================
 */
async function loginMerchant({
  email,
  password
}) {
  const cleanUserEmail = cleanEmail(email);
  const cleanPassword = String(password || "");

  if (!cleanUserEmail || !cleanPassword) {
    throw new Error(
      "Email et mot de passe sont obligatoires."
    );
  }

  /*
   * =======================================================
   * 1. FIREBASE AUTH
   * =======================================================
   */
  const authData = await signInWithFirebase(
    cleanUserEmail,
    cleanPassword
  );

  /*
   * =======================================================
   * 2. VÉRIFICATION DU TOKEN
   * =======================================================
   */
  const decoded = await admin
    .auth()
    .verifyIdToken(authData.idToken);

  /*
   * =======================================================
   * 3. PROFIL FIRESTORE
   * =======================================================
   */
  const snap = await getDb()
    .collection("users")
    .doc(decoded.uid)
    .get();

  if (!snap.exists) {
    throw new Error(
      "Profil commerçant introuvable."
    );
  }

  const profile = snap.data();

  if (profile.role !== "merchant") {
    throw new Error(
      "Ce compte n'est pas un compte commerçant."
    );
  }

  if (!profile.shopId) {
    throw new Error(
      "Boutique du commerçant introuvable."
    );
  }

  /*
   * =======================================================
   * 4. RETOUR FRONTEND
   * =======================================================
   */
  return {
    idToken: authData.idToken,
    refreshToken: authData.refreshToken,
    expiresIn: authData.expiresIn,

    uid: decoded.uid,

    profile
  };
}

module.exports = {
  registerMerchant,
  loginMerchant
};

async function refreshIdToken(refreshToken) {
  const token = String(refreshToken || "").trim();
  const apiKey = String(process.env.FIREBASE_WEB_API_KEY || "").trim();
  if (!token) throw new Error("Refresh token manquant.");
  if (!apiKey) throw new Error("FIREBASE_WEB_API_KEY n'est pas configurée sur le serveur.");

  const response = await fetch(
    `https://securetoken.googleapis.com/v1/token?key=${encodeURIComponent(apiKey)}`,
    {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({ grant_type: "refresh_token", refresh_token: token })
    }
  );
  const data = await response.json().catch(() => ({}));
  if (!response.ok || !data.id_token) {
    const code = data.error?.message || "INVALID_REFRESH_TOKEN";
    if (code.includes("TOKEN_EXPIRED") || code.includes("INVALID_REFRESH_TOKEN") || code.includes("USER_DISABLED")) {
      throw new Error("Session expirée. Veuillez vous reconnecter.");
    }
    throw new Error("Impossible de renouveler la session Firebase.");
  }
  return { idToken: data.id_token, refreshToken: data.refresh_token || token, expiresIn: data.expires_in };
}

module.exports.refreshIdToken = refreshIdToken;
