const { getDb, timestamp } = require("../config/firebase");

function validateIds(shopId, customerId) {
  if (!shopId) {
    throw new Error("shopId requis");
  }

  if (!customerId) {
    throw new Error("customerId requis");
  }

  return {
    shopId: String(shopId).trim(),
    customerId: String(customerId).trim()
  };
}

function cartRef(shopId, customerId) {
  const ids = validateIds(shopId, customerId);

  return getDb()
    .collection("carts")
    .doc(`${ids.shopId}_${ids.customerId}`);
}

function calculateTotal(items) {
  return items.reduce((total, item) => {
    return total + Number(item.subtotal || 0);
  }, 0);
}

async function getCart(shopId, customerId) {
  const ids = validateIds(shopId, customerId);

  const ref = cartRef(ids.shopId, ids.customerId);
  const snap = await ref.get();

  if (!snap.exists) {
    return {
      id: snap.id,
      shopId: ids.shopId,
      customerId: ids.customerId,
      items: [],
      total: 0
    };
  }

  const data = snap.data() || {};

  return {
    id: snap.id,
    shopId: ids.shopId,
    customerId: ids.customerId,
    items: Array.isArray(data.items) ? data.items : [],
    total: Number(data.total || 0),
    createdAt: data.createdAt || null,
    updatedAt: data.updatedAt || null
  };
}

async function addItem(shopId, customerId, productId, quantity) {
  const ids = validateIds(shopId, customerId);

  if (!productId) {
    throw new Error("productId requis");
  }

  const qty = Number(quantity);

  if (!Number.isInteger(qty) || qty <= 0) {
    throw new Error("Quantité invalide");
  }

  const productSnap = await getDb()
    .collection("products")
    .doc(String(productId))
    .get();

  if (!productSnap.exists) {
    throw new Error("Produit introuvable");
  }

  const product = productSnap.data();

  if (String(product.shopId) !== ids.shopId) {
    throw new Error("Produit introuvable dans cette boutique");
  }

  if (product.active === false) {
    throw new Error("Produit indisponible");
  }

  const price = Number(product.price);
  const stock = Number(product.stock);

  if (!Number.isFinite(price) || price < 0) {
    throw new Error("Prix du produit invalide");
  }

  if (!Number.isFinite(stock) || stock < 0) {
    throw new Error("Stock du produit invalide");
  }

  const cart = await getCart(ids.shopId, ids.customerId);

  const items = Array.isArray(cart.items)
    ? cart.items.map(item => ({ ...item }))
    : [];

  const productIdString = String(productId);

  const existing = items.find(
    item => String(item.productId) === productIdString
  );

  const currentQty = existing
    ? Number(existing.quantity || 0)
    : 0;

  const newQty = currentQty + qty;

  if (newQty > stock) {
    throw new Error("Stock insuffisant");
  }

  if (existing) {
    existing.quantity = newQty;
    existing.unitPrice = price;
    existing.subtotal = newQty * price;
    existing.name = product.name;
  } else {
    items.push({
      productId: productIdString,
      name: product.name,
      unitPrice: price,
      quantity: qty,
      subtotal: qty * price
    });
  }

  const total = calculateTotal(items);

  const data = {
    shopId: ids.shopId,
    customerId: ids.customerId,
    items,
    total,
    updatedAt: timestamp()
  };

  const ref = cartRef(ids.shopId, ids.customerId);
  const existingCartSnap = await ref.get();

  if (!existingCartSnap.exists) {
    data.createdAt = timestamp();
  }

  await ref.set(data, { merge: true });

  return getCart(ids.shopId, ids.customerId);
}

async function removeItem(shopId, customerId, productId) {
  const ids = validateIds(shopId, customerId);

  if (!productId) {
    throw new Error("productId requis");
  }

  const cart = await getCart(ids.shopId, ids.customerId);

  const items = cart.items.filter(
    item => String(item.productId) !== String(productId)
  );

  const total = calculateTotal(items);

  await cartRef(ids.shopId, ids.customerId).set(
    {
      shopId: ids.shopId,
      customerId: ids.customerId,
      items,
      total,
      updatedAt: timestamp()
    },
    { merge: true }
  );

  return getCart(ids.shopId, ids.customerId);
}

async function clearCart(shopId, customerId) {
  const ids = validateIds(shopId, customerId);

  await cartRef(ids.shopId, ids.customerId).set(
    {
      shopId: ids.shopId,
      customerId: ids.customerId,
      items: [],
      total: 0,
      updatedAt: timestamp()
    },
    { merge: true }
  );

  return getCart(ids.shopId, ids.customerId);
}

module.exports = {
  getCart,
  addItem,
  removeItem,
  clearCart
};
