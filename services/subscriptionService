const { getDb, timestamp } = require("../config/firebase");
const { getPlan } = require("../config/plans");

async function getSubscription(shopId) {
  const snap = await getDb().collection("subscriptions").doc(String(shopId)).get();
  return snap.exists ? { id: snap.id, ...snap.data() } : null;
}

function isExpired(subscription) {
  if (!subscription) return true;
  if (subscription.status !== "active") return true;
  if (!subscription.expiresAt) return false;

  const expires = subscription.expiresAt.toDate
    ? subscription.expiresAt.toDate()
    : new Date(subscription.expiresAt);

  return expires.getTime() <= Date.now();
}

async function assertActive(shopId) {
  const subscription = await getSubscription(shopId);
  if (!subscription || isExpired(subscription)) {
    throw new Error("ABONNEMENT_INACTIF");
  }
  return subscription;
}

async function getLimits(shopId) {
  const subscription = await getSubscription(shopId);
  const plan = getPlan(subscription?.plan);
  return { subscription, plan, active: !isExpired(subscription) };
}

async function canUse(shopId, metric, increment = 1) {
  const { subscription, plan, active } = await getLimits(shopId);
  if (!active) return { allowed: false, reason: "ABONNEMENT_INACTIF" };

  const usageSnap = await getDb().collection("usage").doc(String(shopId)).get();
  const usage = usageSnap.exists ? usageSnap.data() : {};

  const map = {
    products: "maxProducts",
    messages: "maxMessagesMonth",
    orders: "maxOrdersMonth"
  };

  const limitKey = map[metric];
  if (!limitKey) return { allowed: true, subscription, plan, usage };

  const current = Number(usage[metric] || 0);
  const limit = Number(plan[limitKey]);

  return {
    allowed: current + increment <= limit,
    reason: current + increment <= limit ? null : `LIMITE_${metric.toUpperCase()}`,
    current,
    limit,
    subscription,
    plan
  };
}

async function activateSubscription(shopId, planName, days = 30) {
  const plan = getPlan(planName);
  const expiresAt = new Date(Date.now() + Number(days) * 86400000);

  await getDb().collection("subscriptions").doc(String(shopId)).set({
    shopId: String(shopId),
    plan: plan.name,
    status: "active",
    expiresAt,
    updatedAt: timestamp()
  }, { merge: true });

  return getSubscription(shopId);
}

async function deactivateSubscription(shopId) {
  await getDb().collection("subscriptions").doc(String(shopId)).set({
    status: "inactive",
    updatedAt: timestamp()
  }, { merge: true });

  return getSubscription(shopId);
}

module.exports = {
  getSubscription,
  isExpired,
  assertActive,
  getLimits,
  canUse,
  activateSubscription,
  deactivateSubscription
};
