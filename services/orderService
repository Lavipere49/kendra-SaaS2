const { getDb, timestamp } = require("../config/firebase");
const subscriptionService = require("./subscriptionService");
const admin = require("firebase-admin");

const FieldValue = admin.firestore.FieldValue;

function cleanId(value) {
  return String(value || "").trim();
}

async function createOrder(shopId, data = {}) {
  const cleanShopId = cleanId(shopId);

  if (!cleanShopId) {
    throw new Error("shopId est obligatoire");
  }

  await subscriptionService.assertActive(cleanShopId);

  const orderLimit = await subscriptionService.canUse(
    cleanShopId,
    "orders",
    1
  );

  if (!orderLimit.allowed) {
    throw new Error(orderLimit.reason);
  }

  const customerId = cleanId(data.customerId);

  if (!customerId) {
    throw new Error("customerId est obligatoire");
  }

  if (!Array.isArray(data.items) || data.items.length === 0) {
    throw new Error("La commande doit contenir au moins un produit");
  }

  const db = getDb();

  const customerRef = db
    .collection("customers")
    .doc(customerId);

  const customerSnap = await customerRef.get();

  if (
    !customerSnap.exists ||
    String(customerSnap.data().shopId) !== cleanShopId
  ) {
    throw new Error("Client invalide pour cette boutique");
  }

  /*
   * On regroupe les mêmes produits s'ils apparaissent plusieurs fois
   * dans la commande.
   */
  const requestedItems = new Map();

  for (const item of data.items) {
    const productId = cleanId(item.productId);
    const quantity = Number(item.quantity);

    if (
      !productId ||
      !Number.isInteger(quantity) ||
      quantity <= 0
    ) {
      throw new Error("Article de commande invalide");
    }

    requestedItems.set(
      productId,
      (requestedItems.get(productId) || 0) + quantity
    );
  }

  const items = [];
  let total = 0;

  /*
   * On récupère et vérifie tous les produits avant d'écrire.
   */
  for (const [productId, quantity] of requestedItems.entries()) {
    const productRef = db
      .collection("products")
      .doc(productId);

    const productSnap = await productRef.get();

    if (!productSnap.exists) {
      throw new Error("Produit introuvable");
    }

    const product = productSnap.data();

    if (String(product.shopId) !== cleanShopId) {
      throw new Error("Produit invalide pour cette boutique");
    }

    if (product.active === false) {
      throw new Error(`Le produit ${product.name} est indisponible`);
    }

    const stock = Number(product.stock);
    const unitPrice = Number(product.price);

    if (!Number.isFinite(stock) || stock < 0) {
      throw new Error(`Stock invalide pour ${product.name}`);
    }

    if (!Number.isFinite(unitPrice) || unitPrice < 0) {
      throw new Error(`Prix invalide pour ${product.name}`);
    }

    if (stock < quantity) {
      throw new Error(`Stock insuffisant pour ${product.name}`);
    }

    const subtotal = unitPrice * quantity;

    total += subtotal;

    items.push({
      productId: productSnap.id,
      name: product.name,
      quantity,
      unitPrice,
      subtotal
    });
  }

  const orderRef = db.collection("orders").doc();

  const order = {
    id: orderRef.id,
    shopId: cleanShopId,
    customerId,
    items,
    total,

    status: data.status || "pending",
    paymentStatus: data.paymentStatus || "unpaid",

    source: data.source || "kendra",

    createdAt: timestamp(),
    updatedAt: timestamp()
  };

  /*
   * Transaction Firestore :
   * - vérifie une dernière fois le stock
   * - décrémente le stock
   * - crée la commande
   * - met à jour le client
   *
   * Tout réussit ou rien n'est écrit.
   */
  await db.runTransaction(async transaction => {
    const productRefs = items.map(item =>
      db.collection("products").doc(item.productId)
    );

    const productSnapshots = [];

    for (const ref of productRefs) {
      const snap = await transaction.get(ref);
      productSnapshots.push(snap);
    }

    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      const productSnap = productSnapshots[i];

      if (!productSnap.exists) {
        throw new Error("Produit introuvable pendant la transaction");
      }

      const product = productSnap.data();
      const currentStock = Number(product.stock);

      if (currentStock < item.quantity) {
        throw new Error(`Stock insuffisant pour ${item.name}`);
      }

      transaction.update(productRefs[i], {
        stock: FieldValue.increment(-item.quantity),
        updatedAt: timestamp()
      });
    }

    transaction.set(orderRef, order);

    transaction.update(customerRef, {
      totalOrders: FieldValue.increment(1),
      totalSpent: FieldValue.increment(total),
      lastContactAt: timestamp(),
      updatedAt: timestamp()
    });
  });

  /*
   * Mise à jour de l'utilisation après la création réussie
   * de la commande.
   */
  await db.collection("usage").doc(cleanShopId).set(
    {
      orders: FieldValue.increment(1),
      updatedAt: timestamp()
    },
    { merge: true }
  );

  return order;
}

async function getOrder(shopId, orderId) {
  const cleanShopId = cleanId(shopId);
  const cleanOrderId = cleanId(orderId);

  if (!cleanShopId || !cleanOrderId) {
    return null;
  }

  const snap = await getDb()
    .collection("orders")
    .doc(cleanOrderId)
    .get();

  if (!snap.exists) {
    return null;
  }

  const data = snap.data();

  if (String(data.shopId) !== cleanShopId) {
    return null;
  }

  return {
    id: snap.id,
    ...data
  };
}

async function listOrders(shopId) {
  const cleanShopId = cleanId(shopId);

  if (!cleanShopId) {
    throw new Error("shopId est obligatoire");
  }

  const snap = await getDb()
    .collection("orders")
    .where("shopId", "==", cleanShopId)
    .get();

  const orders = snap.docs.map(doc => ({
    id: doc.id,
    ...doc.data()
  }));

  /*
   * Les commandes les plus récentes apparaissent en premier.
   */
  orders.sort((a, b) => {
    const aTime = a.createdAt?.toMillis
      ? a.createdAt.toMillis()
      : 0;

    const bTime = b.createdAt?.toMillis
      ? b.createdAt.toMillis()
      : 0;

    return bTime - aTime;
  });

  return orders;
}

async function updateOrder(shopId, orderId, data = {}) {
  const cleanShopId = cleanId(shopId);
  const cleanOrderId = cleanId(orderId);

  if (!cleanShopId || !cleanOrderId) {
    throw new Error("shopId et orderId sont obligatoires");
  }

  const order = await getOrder(
    cleanShopId,
    cleanOrderId
  );

  if (!order) {
    return null;
  }

  const update = {};

  const allowedStatuses = [
    "pending",
    "confirmed",
    "processing",
    "shipped",
    "delivered",
    "cancelled"
  ];

  const allowedPaymentStatuses = [
    "unpaid",
    "pending",
    "paid",
    "failed",
    "refunded"
  ];

  if (data.status !== undefined) {
    if (!allowedStatuses.includes(data.status)) {
      throw new Error("Statut de commande invalide");
    }

    update.status = data.status;
  }

  if (data.paymentStatus !== undefined) {
    if (!allowedPaymentStatuses.includes(data.paymentStatus)) {
      throw new Error("Statut de paiement invalide");
    }

    update.paymentStatus = data.paymentStatus;
  }

  update.updatedAt = timestamp();

  await getDb()
    .collection("orders")
    .doc(cleanOrderId)
    .update(update);

  return getOrder(cleanShopId, cleanOrderId);
}

module.exports = {
  createOrder,
  getOrder,
  listOrders,
  updateOrder
};
